{% extends 'layouts/lecturer.twig' %}

{% block title %}My Documents{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>My documents</h1>
    <div class="sub">Files you've uploaded yourself — grading sheets, templates, references. Available to attach as a resource when scheduling a meeting.</div>
  </div>
  <div class="ref">MY-DOCS</div>
</div>

{% if success %}<div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>{% endif %}
{% if error %}<div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>{% endif %}

<div class="section-title">Upload a document<div class="rule"></div></div>
<div class="form-card" style="margin-bottom:32px;">
  <form method="POST" action="/lecturer/my-documents/upload" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="field-row">
      <div class="field">
        <label>Document type</label>
        <select name="document_type_id" required>
          <option value="">-- Select --</option>
          {% for dt in document_types %}<option value="{{ dt.doc_type_id }}">{{ dt.doc_type_name }}</option>{% endfor %}
        </select>
      </div>
      <div class="field">
        <label>File</label>
        <input type="file" name="document_file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" required>
      </div>
    </div>
    <div class="meta" style="margin-bottom:14px;">PDF, Word, Excel, or PowerPoint — up to 10MB.</div>
    <button type="submit" class="btn brass">Upload</button>
  </form>
</div>

<div class="section-title">Uploaded documents<div class="rule"></div></div>
<div class="meta" style="margin-bottom:14px;">Your own resources — grading sheets, templates, references.</div>

{% if documents %}
  <table style="margin-bottom:32px;">
    <thead><tr><th>File</th><th>Type</th><th>Uploaded</th><th></th></tr></thead>
    <tbody>
      {% for doc in documents %}
        <tr>
          <td class="strong">{{ doc.file_name }}</td>
          <td class="mono">{{ doc.doc_type_name }}</td>
          <td class="mono">{{ doc.uploaded_at|date('d M Y') }}</td>
          <td><a href="/{{ doc.file_path }}" target="_blank" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">View / download</a></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice" style="margin-bottom:32px;">You haven't uploaded any documents yet.</div>
{% endif %}

<div class="section-title">Exam review evidence<div class="rule"></div></div>
<div class="meta" style="margin-bottom:14px;">Supporting files you attached while reviewing a document under a formal exam window.</div>

{% if exam_review_documents %}
  <table style="margin-bottom:32px;">
    <thead><tr><th>File</th><th>Meeting</th><th>Document reviewed</th><th>Uploaded</th><th></th></tr></thead>
    <tbody>
      {% for doc in exam_review_documents %}
        <tr>
          <td class="strong">{{ doc.file_name }}</td>
          <td class="mono">{{ doc.exam_review_meeting_type|replace({'_': ' '})|capitalize }}<div class="meta" style="margin-top:2px;">{{ doc.exam_review_meeting_at|date('d M Y H:i') }}</div></td>
          <td>{{ doc.exam_reviewed_doc_type_name }} — {{ doc.exam_reviewed_file_name }}</td>
          <td class="mono">{{ doc.uploaded_at|date('d M Y') }}</td>
          <td><a href="/{{ doc.file_path }}" target="_blank" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">View / download</a></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice" style="margin-bottom:32px;">No exam review evidence uploaded yet.</div>
{% endif %}

<div class="section-title">Document review evidence<div class="rule"></div></div>
<div class="meta" style="margin-bottom:14px;">Supporting files you attached while reviewing a document outside a formal exam window.</div>

{% if general_review_documents %}
  <table>
    <thead><tr><th>File</th><th>Meeting</th><th>Document(s) reviewed</th><th>Uploaded</th><th></th></tr></thead>
    <tbody>
      {% for doc in general_review_documents %}
        <tr>
          <td class="strong">{{ doc.file_name }}</td>
          <td class="mono">{{ doc.general_review_meeting_type|replace({'_': ' '})|capitalize }}<div class="meta" style="margin-top:2px;">{{ doc.general_review_meeting_at|date('d M Y H:i') }}</div></td>
          <td>{{ doc.general_reviewed_file_names ?? '—' }}</td>
          <td class="mono">{{ doc.uploaded_at|date('d M Y') }}</td>
          <td><a href="/{{ doc.file_path }}" target="_blank" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">View / download</a></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice">No document review evidence uploaded yet.</div>
{% endif %}

{% endblock %}
