{% extends 'layouts/lecturer.twig' %}

{% block title %}Documents{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Documents</h1>
    <div class="sub">All files submitted by students under your supervision, awaiting or already reviewed.</div>
  </div>
  <div class="ref">DOC-{{ staff_number }}</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

<form method="GET" action="/lecturer/documents" class="form-card" style="margin-bottom:26px; display:flex; gap:14px; align-items:flex-end;">
  <div class="field" style="margin:0; flex:1;">
    <label>Student</label>
    <select name="student_id" onchange="this.form.submit()">
      <option value="">All students</option>
      {% for s in students %}
        <option value="{{ s.student_id }}" {{ selected_student == s.student_id ? 'selected' : '' }}>{{ s.student_name }} — {{ s.student_number }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="field" style="margin:0; flex:1;">
    <label>Status</label>
    <select name="status" onchange="this.form.submit()">
      <option value="">All statuses</option>
      <option value="pending" {{ selected_status == 'pending' ? 'selected' : '' }}>Pending</option>
      <option value="valid" {{ selected_status == 'valid' ? 'selected' : '' }}>Valid</option>
      <option value="rejected" {{ selected_status == 'rejected' ? 'selected' : '' }}>Rejected</option>
    </select>
  </div>
</form>

{% if documents %}
  <table>
    <thead><tr><th>Student</th><th>File</th><th>Type</th><th>Uploaded</th><th>Status</th><th></th></tr></thead>
    <tbody>
      {% for doc in documents %}
        <tr>
          <td class="strong">{{ doc.student_name }}</td>
          <td>{{ doc.file_name }}</td>
          <td class="mono">{{ doc.doc_type_name }}</td>
          <td class="mono">{{ doc.uploaded_at|date('d M Y') }}</td>
          <td>
            {% if doc.validation_status == 'valid' %}
              <span class="stamp mini approved">Valid</span>
            {% elseif doc.validation_status == 'rejected' %}
              <span class="stamp mini rejected">Rejected</span>
            {% else %}
              <span class="stamp mini pending">Pending</span>
            {% endif %}
          </td>
          <td style="white-space:nowrap;">
            <a href="/{{ doc.file_path }}" target="_blank" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">View document</a>
            {% if doc.validation_status == 'pending' %}
              <button type="button" class="btn ghost" style="padding:6px 12px; font-size:.72rem;" onclick="openModal('docModal-{{ doc.document_id }}')">Review</button>
            {% elseif doc.validation_notes %}
              <span class="meta" style="margin:0;">{{ doc.validation_notes }}</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice">No documents match this filter.</div>
{% endif %}

{% for doc in documents %}
  {% if doc.validation_status == 'pending' %}
    <div class="modal-overlay" id="docModal-{{ doc.document_id }}" onclick="closeModal(event,'docModal-{{ doc.document_id }}')">
      <div class="modal" onclick="event.stopPropagation()">
        <button type="button" class="modal-close" onclick="hideModal('docModal-{{ doc.document_id }}')">✕ Close</button>
        <div class="ref">{{ doc.student_name }} · {{ doc.doc_type_name }}</div>
        <h2>Review document</h2>
        <div class="sub">{{ doc.file_name }} — uploaded {{ doc.uploaded_at|date('d M Y') }}</div>
        <a href="/{{ doc.file_path }}" target="_blank" class="btn ghost" style="margin-bottom:16px;">View document</a>

        <form method="POST" action="/lecturer/documents/validate">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="document_id" value="{{ doc.document_id }}">

          <div class="field">
            <label>Notes (optional)</label>
            <textarea name="notes" rows="3" placeholder="Comments for the student's record..."></textarea>
          </div>

          <div class="modal-actions">
            <button type="submit" name="status" value="rejected" class="btn ghost">Reject</button>
            <button type="submit" name="status" value="valid" class="btn brass">Mark valid</button>
          </div>
        </form>
      </div>
    </div>
  {% endif %}
{% endfor %}

{% endblock %}