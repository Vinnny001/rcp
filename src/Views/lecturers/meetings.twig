{% extends 'layouts/lecturer.twig' %}
{% import 'partials/_resources_macro.twig' as resources_macro %}

{% block title %}Meetings & Grading{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Meetings &amp; grading</h1>
    <div class="sub">Your meetings, your students' exams, and outstanding examination scores.</div>
  </div>
  <div class="ref">CAL-{{ staff_number }}</div>
</div>

{% if success %}<div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>{% endif %}
{% if error %}<div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>{% endif %}

<div class="section-title">Your students' exams<div class="rule"></div></div>
<div style="font-size:.82rem; color:var(--slate); margin-bottom:12px;">
  Students book their exam date and the research coordinator schedules the exam. You can see where each stands and remind your student.
</div>

{% if supervisee_exams %}
  <div class="grid cols-2" style="margin-bottom:32px;">
    {% for e in supervisee_exams %}
      <div class="card">
        <h3>{{ e.student_name }} — {{ e.stage_name }}</h3>
        <div class="meta mono" style="font-size:.72rem;">{{ e.student_number }}</div>

        {% if e.booked %}
          <div class="meta">
            Booked for {{ e.booked.starts_at|date('d M Y') }}{% if e.booked.starts_at|date('Y-m-d') != e.booked.ends_at|date('Y-m-d') %} – {{ e.booked.ends_at|date('d M Y') }}{% endif %}
            · {{ e.booked.exam_type|capitalize }} examination{% if e.booked.exam_schedule_description %} · {{ e.booked.exam_schedule_description }}{% endif %}
          </div>
          {% if e.booked.meeting_id %}
            <span class="stamp mini approved">Exam scheduled</span>
            <div class="meta" style="margin-top:6px;">
              {{ e.booked.meeting_at|date('D, j M Y · g:i A') }}{% if e.booked.meeting_mode %} · {{ e.booked.meeting_mode|capitalize }}{% endif %}
              {%- if e.booked.meeting_location %} · {{ e.booked.meeting_location }}{% endif %}
              {%- if e.booked.meeting_link %} · <a href="{{ e.booked.meeting_link }}" target="_blank" rel="noopener noreferrer">join link</a>{% endif %}
            </div>
          {% elseif e.booked.blockers %}
            <span class="stamp mini pending">Waiting on the student</span>
            <ul style="font-size:.8rem; margin:6px 0 0 16px; padding:0; color: var(--rust);">
              {% for b in e.booked.blockers %}<li>{{ b }}</li>{% endfor %}
            </ul>
          {% else %}
            <span class="stamp mini pending">Waiting for the coordinator to schedule it</span>
          {% endif %}
        {% else %}
          <span class="stamp mini pending">Not booked</span>
          <div class="meta" style="margin-top:6px;">{{ e.open_dates }} date{{ e.open_dates != 1 ? 's' }} open for booking.</div>
        {% endif %}

        <details style="margin-top:12px;">
          <summary style="cursor:pointer; font-size:.8rem; font-weight:600;">Remind {{ e.first_name }}</summary>
          <form method="POST" action="/lecturer/notifications/send" style="margin-top:10px;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="mode" value="student">
            <input type="hidden" name="student_user_id[]" value="{{ e.student_user_id }}">
            <input type="hidden" name="return_to" value="/lecturer/meetings">
            <div class="field"><label>Subject</label><input type="text" name="subject" value="{{ e.reminder.subject }}" required></div>
            <div class="field"><label>Message</label><textarea name="message" rows="3" required>{{ e.reminder.message }}</textarea></div>
            <button type="submit" class="btn brass" style="padding:6px 14px; font-size:.74rem;">Send reminder</button>
          </form>
        </details>
      </div>
    {% endfor %}
  </div>
{% else %}
  <div class="notice" style="margin-bottom:32px;">None of your students has an exam open at the stage they are on.</div>
{% endif %}

<div class="section-title">
  Scheduled meetings<div class="rule"></div>
  <button class="btn ghost" style="padding:6px 14px; font-size:.74rem;" onclick="openModal('scheduleModal')">Schedule meeting</button>
</div>

{% if upcoming %}
  <div class="grid cols-2" style="margin-bottom:32px;">
    {% for m in upcoming %}
      <div class="card">
        <h3>{{ m.meeting_type|replace({'_': ' '})|capitalize }}{% if m.proposal_title %} — {{ m.proposal_title }}{% endif %}</h3>
        <div class="meta">
          {{ m.scheduled_at|date('D, j M Y') }} · {{ m.scheduled_at|date('g:i A') }} · {{ m.mode|capitalize }}
          {% if m.mode in ['virtual', 'hybrid'] and m.virtual_link %} — <a href="{{ m.virtual_link }}" target="_blank">{{ m.virtual_link }}</a>{% endif %}
          {% if m.mode in ['physical', 'hybrid'] and m.location %} — {{ m.location }}{% endif %}
        </div>
        {% if m.other_attendees %}<div class="meta">With {{ m.other_attendees }}</div>{% endif %}

        {% if m.status == 'cancelled' %}
          <span class="stamp mini rejected">Cancelled</span>
          {% if m.status_description %}
            <p style="font-size:.85rem; line-height:1.6; color:var(--rust); margin-top:8px;">Reason: {{ m.status_description }}</p>
          {% endif %}
        {% else %}
          <span class="stamp mini pending">{{ m.status == 'in_progress' ? 'In progress' : 'Scheduled' }}</span>
        {% endif %}

        {% if m.secure_code and m.status != 'cancelled' %}
          <div class="notice" style="margin-top:12px; border-left-color: var(--brass-deep); background:#faf6ec;">
            <div style="font-size:.68rem; text-transform:uppercase; letter-spacing:.09em; color:var(--slate);">Attendance code — yours only</div>
            <div class="mono" style="font-size:1.3rem; letter-spacing:.22em; font-weight:600;">{{ m.secure_code }}</div>
            <div class="meta" style="margin:4px 0 0;">Read this out during the meeting. Attendees must enter it to submit a review.</div>
          </div>
        {% endif %}

        {{ resources_macro.resources_block(m.resources) }}

        <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
          {% if m.status != 'cancelled' and m.my_role in ['examiner', 'chairperson', 'supervisor'] and (m.exam_schedule_id or m.document_count > 0) %}
            <a href="/lecturer/meetings/{{ m.meeting_id }}/review" class="btn brass" style="padding:6px 12px; font-size:.72rem;">Give review</a>
          {% endif %}
          {% if m.my_role == 'supervisor' and m.status != 'cancelled' and m.meeting_type == 'supervisory' %}
            <a href="/lecturer/meetings/{{ m.meeting_id }}/edit" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">Edit</a>
            <button type="button" class="btn ghost" style="padding:6px 12px; font-size:.72rem; color:var(--rust); border-color:var(--rust);"
              onclick="openStatusModal('{{ m.meeting_id }}', '{{ m.meeting_type|replace({'_': ' '})|capitalize|escape('js') }}', '{{ m.scheduled_at|date('j M Y, g:i A')|escape('js') }}')">
              Cancel / change status
            </button>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <div class="notice" style="margin-bottom:32px;">No meetings scheduled.</div>
{% endif %}

{% if past %}
  <div class="section-title">Past meetings<div class="rule"></div></div>
  {% for m in past %}
    <div class="card" style="margin-bottom:14px;">
      <h3>{{ m.meeting_type|replace({'_': ' '})|capitalize }}{% if m.proposal_title %} — {{ m.proposal_title }}{% endif %}</h3>
      <div class="meta">
        {{ m.scheduled_at|date('j M Y') }} · {{ m.mode|capitalize }}
        {% if m.mode in ['virtual', 'hybrid'] and m.virtual_link %} — <a href="{{ m.virtual_link }}" target="_blank">{{ m.virtual_link }}</a>{% endif %}
        {% if m.other_attendees %} · With {{ m.other_attendees }}{% endif %}
      </div>
      {% if m.ai_summary %}<p style="font-size:.85rem; line-height:1.6; color:#39332a; margin-top:10px;">{{ m.ai_summary }}</p>{% endif %}

      {% if m.status == 'cancelled' %}
        <span class="stamp mini rejected">Cancelled</span>
        {% if m.status_description %}
          <p style="font-size:.85rem; line-height:1.6; color:var(--rust); margin-top:8px;">Reason: {{ m.status_description }}</p>
        {% endif %}
      {% elseif m.status == 'completed' %}
        <span class="stamp mini approved">Completed</span>
        {% if m.status_description %}
          <p style="font-size:.85rem; line-height:1.6; color:#39332a; margin-top:8px;">{{ m.status_description }}</p>
        {% endif %}
      {% elseif m.my_role == 'supervisor' and m.meeting_type == 'supervisory' %}
        <div style="margin-top:10px;">
          <button type="button" class="btn ghost" style="padding:6px 12px; font-size:.72rem;"
            onclick="openStatusModal('{{ m.meeting_id }}', '{{ m.meeting_type|replace({'_': ' '})|capitalize|escape('js') }}', '{{ m.scheduled_at|date('j M Y, g:i A')|escape('js') }}')">
            Change status
          </button>
        </div>
      {% endif %}

      {{ resources_macro.resources_block(m.resources) }}
    </div>
  {% endfor %}
{% endif %}

<div class="section-title">Grade an examination<div class="rule"></div></div>
{% if pending_grading %}
  {% for g in pending_grading %}
    <div class="form-card" style="margin-bottom:18px;">
      <div class="meta" style="margin-bottom:16px;">
        {{ g.student_name }} · {{ g.exam_type|capitalize }} examination · {{ g.exam_date ? g.exam_date|date('d M Y') : 'Date TBC' }}
        {% if g.title %} · "{{ g.title }}"{% endif %} · You are the {{ g.examiner_type }} examiner
      </div>
      <form method="POST" action="/lecturer/meetings/grade">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="grader_id" value="{{ g.grader_id }}">
        <div class="field"><label>Score (0–100)</label><input type="number" name="score" min="0" max="100" step="0.01" required></div>
        <div class="field"><label>Feedback</label><textarea name="feedback" rows="3"></textarea></div>
        <button type="submit" class="btn brass">Submit grade</button>
      </form>
    </div>
  {% endfor %}
{% else %}
  <div class="notice">No examinations awaiting your grade right now.</div>
{% endif %}

<!-- MODAL: GENERAL SCHEDULE (unchanged from before) -->
<div class="modal-overlay" id="scheduleModal" onclick="closeModal(event,'scheduleModal')">
  <div class="modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideModal('scheduleModal')">✕ Close</button>
    <div class="ref">CAL-{{ staff_number }} · NEW MEETING</div>
    <h2>Schedule a meeting</h2>
    <form method="POST" action="/lecturer/meetings/schedule">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field">
        <label>Student</label>
        <select name="proposal_id" id="genStudentSelect" required onchange="onGeneralStudentChange()">
          <option value="">Select a student</option>
          {% for s in students %}
            {% if s.proposal_id %}
              <option value="{{ s.proposal_id }}" data-user-id="{{ s.student_user_id }}">{{ s.student_name }} — {{ s.student_number }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
      <div class="field" style="display:flex; align-items:center; gap:8px; margin-top:-6px;">
        <input type="checkbox" name="include_student" checked style="width:auto;" id="includeStudent">
        <label for="includeStudent" style="margin:0; text-transform:none; letter-spacing:0; font-family:'IBM Plex Sans',sans-serif; font-size:.82rem;">Invite this student</label>
      </div>
      <input type="hidden" name="meeting_type" value="supervisory">
      <div class="meta" style="margin:-4px 0 14px;">
        A supervisory meeting. Exam meetings are scheduled by the research coordinator once your student books a date.
      </div>
      <div class="field-row">
        <div class="field"><label>Date</label><input type="date" name="date" required></div>
        <div class="field"><label>Time</label><input type="time" name="time" required></div>
      </div>
      <label>Mode</label>
      <div class="mode-pick">
        <button type="button" class="active" data-mode="physical" onclick="pickMode(this)">Physical</button>
        <button type="button" data-mode="virtual" onclick="pickMode(this)">Virtual</button>
        <button type="button" data-mode="hybrid" onclick="pickMode(this)">Hybrid</button>
      </div>
      <input type="hidden" name="mode" id="modeInput" value="physical">
      <div class="field" id="locationField"><label>Location</label><input type="text" name="location"></div>
      <div class="field" id="virtualLinkField"><label>Virtual link</label><input type="text" name="virtual_link"></div>
      <div class="field" style="display:flex; align-items:center; gap:8px;">
        <input type="checkbox" name="ai_notes_enabled" checked style="width:auto;" id="aiNotes">
        <label for="aiNotes" style="margin:0; text-transform:none; letter-spacing:0; font-family:'IBM Plex Sans',sans-serif; font-size:.82rem;">Enable AI meeting notes</label>
      </div>
      <div class="section-title" style="margin:24px 0 12px; font-size:.95rem;">Documents for review<div class="rule"></div></div>
      <div class="field">
        <div class="meta" style="margin:0 0 8px;">Optional. Tick any of this student's documents the meeting should review — invited examiners and you can then score and comment on them.</div>
        <div id="genDocumentList">
          <div class="meta">Select a student first.</div>
        </div>
      </div>

      <div class="section-title" style="margin:24px 0 12px; font-size:.95rem;">Other attendees<div class="rule"></div></div>
      <div class="field">
        <select id="genInviteSelect">
          <option value="">Select a lecturer</option>
          {% for l in other_lecturers %}<option value="{{ l.user_id }}" data-name="{{ l.name|escape('html_attr') }}">{{ l.name }}{% if l.affiliation %} — {{ l.affiliation }}{% endif %}</option>{% endfor %}
        </select>
        <select id="genInviteRole" style="margin-top:8px;">
          <option value="examiner">Examiner</option>
          <option value="chairperson">Chairperson</option>
          <option value="supervisor">Co-supervisor</option>
          <option value="observer">Observer</option>
        </select>
        <button type="button" class="btn ghost" style="margin-top:8px; padding:6px 14px; font-size:.72rem;" onclick="addInvite('gen')">Invite</button>
        <div id="genInviteList" style="margin-top:10px;"></div>
      </div>

      <details class="field" style="border:1px solid var(--paper-line); border-radius:var(--radius); padding:14px; background:#fbf8f1; margin-top:24px;">
        <summary style="cursor:pointer; font-size:.86rem; font-weight:600; text-transform:none; letter-spacing:0; font-family:'IBM Plex Sans',sans-serif;">
          Resources (optional) — documents or links every attendee can view, not scored
        </summary>
        <div style="margin-top:14px;">
          <div class="meta" style="margin:0 0 6px;">This student's documents</div>
          <div id="genResourceStudentDocs" style="margin-bottom:14px;"><div class="meta">Select a student first.</div></div>

          {% if my_documents %}
            <div class="meta" style="margin:0 0 6px;">My uploaded documents</div>
            <div style="margin-bottom:14px;">
              {% for doc in my_documents %}
                <label style="display:flex; align-items:center; gap:8px; padding:4px 0; font-size:.82rem; text-transform:none; letter-spacing:0; font-family:'IBM Plex Sans',sans-serif;">
                  <input type="checkbox" name="resource_documents[]" value="{{ doc.document_id }}" style="width:auto;">
                  <span>{{ doc.doc_type_name }} — {{ doc.file_name }}</span>
                </label>
              {% endfor %}
            </div>
          {% endif %}

          <div class="meta" style="margin:0 0 6px;">Add a link</div>
          <input type="text" id="genResourceLinkUrl" placeholder="https://...">
          <input type="text" id="genResourceLinkLabel" placeholder="Label (e.g. Grading sheet)" style="margin-top:8px;">
          <button type="button" class="btn ghost" style="margin-top:8px; padding:6px 14px; font-size:.72rem;" onclick="addResourceLink('gen')">Add link</button>
          <div id="genResourceLinkList" style="margin-top:10px;"></div>
        </div>
      </details>

      <div class="modal-actions">
        <button type="button" class="btn ghost" onclick="hideModal('scheduleModal')">Cancel</button>
        <button type="submit" class="btn brass">Schedule meeting</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: CANCEL / CHANGE STATUS -->
<div class="modal-overlay" id="statusModal" onclick="closeModal(event,'statusModal')">
  <div class="modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideModal('statusModal')">✕ Close</button>
    <div class="ref">MEETING STATUS</div>
    <h2 id="statusModalTitle">Change meeting status</h2>
    <div class="sub" id="statusModalWhen"></div>

    <form method="POST" id="statusForm" action="">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      <div class="field">
        <label>New status</label>
        <select name="status" id="statusSelect" onchange="onStatusChange()" required>
          <option value="cancelled">Cancelled</option>
          <option value="in_progress">In progress</option>
          <option value="completed">Completed</option>
        </select>
      </div>

      <div class="field">
        <label id="statusReasonLabel">Reason for cancelling</label>
        <textarea name="status_description" id="statusReason" rows="4"
                  placeholder="e.g. The external examiner is unavailable — a new date will follow."></textarea>
        <div class="meta" id="statusReasonHint" style="margin-top:6px;">Required. The student sees this on their meetings page.</div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn ghost" onclick="hideModal('statusModal')">Never mind</button>
        <button type="submit" class="btn brass">Save status</button>
      </div>
    </form>
  </div>
</div>

{% endblock %}

{% block extra_scripts %}
<script>
  const internalLecturers = [
    {% for l in internal_lecturers %}{ id: "{{ l.user_id }}", name: "{{ l.name|escape('js') }}", affiliation: "{{ l.affiliation|default('')|escape('js') }}" },{% endfor %}
  ];
  const externalLecturers = [
    {% for l in external_lecturers %}{ id: "{{ l.user_id }}", name: "{{ l.name|escape('js') }}", affiliation: "{{ l.affiliation|default('')|escape('js') }}" },{% endfor %}
  ];

  // Every supervisee document, tagged with whose it is, so the picker
  // can be rebuilt for whichever student is selected.
  const superviseeDocuments = [
    {% for d in supervisee_documents %}{ id: "{{ d.document_id }}", studentUserId: "{{ d.student_user_id }}", name: "{{ d.file_name|escape('js') }}", type: "{{ d.doc_type_name|escape('js') }}", status: "{{ d.document_status|escape('js') }}" },{% endfor %}
  ];

  const invites = { gen: [], exam: [] };
  const resourceLinks = { gen: [], exam: [] };

  function toggleModeFields(prefix, mode){
    const locField = document.getElementById(prefix === 'gen' ? 'locationField' : 'examLocationField');
    const linkField = document.getElementById(prefix === 'gen' ? 'virtualLinkField' : 'examVirtualLinkField');
    locField.style.display = (mode === 'virtual') ? 'none' : '';
    linkField.style.display = (mode === 'physical') ? 'none' : '';
  }

  function pickMode(btn){
    btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('modeInput').value = btn.dataset.mode;
    toggleModeFields('gen', btn.dataset.mode);
  }

  function pickExamMeetingMode(btn){
    btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('examMeetingModeInput').value = btn.dataset.mode;
    toggleModeFields('exam', btn.dataset.mode);
  }

  function addInvite(prefix){
    const select = document.getElementById(prefix === 'gen' ? 'genInviteSelect' : 'examInviteSelect');
    const roleSelect = document.getElementById(prefix === 'gen' ? 'genInviteRole' : 'examInviteRole');
    const userId = select.value;
    const name = select.options[select.selectedIndex]?.dataset.name || select.options[select.selectedIndex]?.text;
    const role = roleSelect.value;
    if (!userId) return;
    if (invites[prefix].some(i => i.id === userId)) return;

    invites[prefix].push({ id: userId, name, role });
    renderInvites(prefix);
    select.querySelector('option[value="' + userId + '"]')?.remove();
    select.value = '';
  }

  function removeInvite(prefix, userId){
    invites[prefix] = invites[prefix].filter(i => i.id !== userId);
    renderInvites(prefix);
  }

  function renderInvites(prefix){
    const container = document.getElementById(prefix === 'gen' ? 'genInviteList' : 'examInviteList');
    container.innerHTML = '';
    invites[prefix].forEach(i => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:6px 0; font-size:.82rem;';
      row.innerHTML = '<span>' + i.name + ' — ' + i.role + '</span>';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = 'Remove';
      btn.className = 'btn ghost';
      btn.style.cssText = 'padding:3px 10px; font-size:.68rem;';
      btn.onclick = () => removeInvite(prefix, i.id);
      row.appendChild(btn);
      container.appendChild(row);

      const hidUser = document.createElement('input');
      hidUser.type = 'hidden'; hidUser.name = 'attendee_lecturers[]'; hidUser.value = i.id;
      const hidRole = document.createElement('input');
      hidRole.type = 'hidden'; hidRole.name = 'attendee_roles[]'; hidRole.value = i.role;
      container.appendChild(hidUser);
      container.appendChild(hidRole);
    });
  }

  function selectedGeneralStudentUserId(){
    const select = document.getElementById('genStudentSelect');
    return select.options[select.selectedIndex]?.dataset.userId || '';
  }

  /**
   * A supervised student may hold a lecturer account of their own. When
   * that student is the subject of the meeting they must not also be
   * offered as an attendee, so their option is pulled out of the invite
   * dropdown (and restored when a different student is picked).
   */
  function onGeneralStudentChange(){
    const studentUserId = selectedGeneralStudentUserId();
    const select = document.getElementById('genInviteSelect');

    Array.from(select.options).forEach(opt => {
      if (!opt.value) return;
      const isSubject = opt.value === studentUserId;
      opt.hidden = isSubject;
      opt.disabled = isSubject;
    });

    // Drop them from any invites already staged before the switch.
    if (studentUserId && invites.gen.some(i => i.id === studentUserId)) {
      invites.gen = invites.gen.filter(i => i.id !== studentUserId);
      renderInvites('gen');
    }

    renderDocumentChecklist('genDocumentList', 'review_documents[]', studentUserId, 'Select a student first.');
    renderDocumentChecklist('genResourceStudentDocs', 'resource_documents[]', studentUserId, 'Select a student first.');
  }

  /**
   * Renders a student's documents as a checkbox list into a container —
   * used for both the "documents for review" picker and the "resources"
   * picker, which draw from the same document set but write into
   * different form fields (review_documents[] vs resource_documents[]).
   */
  function renderDocumentChecklist(containerId, fieldName, studentUserId, emptyMessage){
    const container = document.getElementById(containerId);
    container.innerHTML = '';

    if (!studentUserId) {
      container.innerHTML = '<div class="meta">' + emptyMessage + '</div>';
      return;
    }

    const docs = superviseeDocuments.filter(d => d.studentUserId === studentUserId);

    if (!docs.length) {
      container.innerHTML = '<div class="meta">This student has not uploaded any documents yet.</div>';
      return;
    }

    docs.forEach(d => {
      const row = document.createElement('label');
      row.style.cssText = 'display:flex; align-items:center; gap:8px; padding:5px 0; font-size:.82rem; text-transform:none; letter-spacing:0; font-family:\'IBM Plex Sans\',sans-serif;';

      const box = document.createElement('input');
      box.type = 'checkbox';
      box.name = fieldName;
      box.value = d.id;
      box.style.width = 'auto';

      const text = document.createElement('span');
      text.textContent = d.type + ' — ' + d.name + ' (' + d.status.replace('_', ' ') + ')';

      row.appendChild(box);
      row.appendChild(text);
      container.appendChild(row);
    });
  }

  function addResourceLink(prefix){
    const urlInput = document.getElementById(prefix + 'ResourceLinkUrl');
    const labelInput = document.getElementById(prefix + 'ResourceLinkLabel');
    const url = urlInput.value.trim();
    const label = labelInput.value.trim();

    if (!url) return;
    if (!/^https?:\/\//i.test(url)) {
      alert('Links must start with http:// or https://');
      return;
    }

    resourceLinks[prefix].push({ url, label });
    renderResourceLinks(prefix);
    urlInput.value = '';
    labelInput.value = '';
  }

  function removeResourceLink(prefix, index){
    resourceLinks[prefix].splice(index, 1);
    renderResourceLinks(prefix);
  }

  function renderResourceLinks(prefix){
    const container = document.getElementById(prefix + 'ResourceLinkList');
    container.innerHTML = '';

    resourceLinks[prefix].forEach((link, index) => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:6px 0; font-size:.82rem;';
      const span = document.createElement('span');
      span.textContent = link.label ? (link.label + ' — ' + link.url) : link.url;
      row.appendChild(span);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = 'Remove';
      btn.className = 'btn ghost';
      btn.style.cssText = 'padding:3px 10px; font-size:.68rem;';
      btn.onclick = () => removeResourceLink(prefix, index);
      row.appendChild(btn);
      container.appendChild(row);

      const hidUrl = document.createElement('input');
      hidUrl.type = 'hidden'; hidUrl.name = 'resource_links[]'; hidUrl.value = link.url;
      const hidLabel = document.createElement('input');
      hidLabel.type = 'hidden'; hidLabel.name = 'resource_link_labels[]'; hidLabel.value = link.label;
      container.appendChild(hidUrl);
      container.appendChild(hidLabel);
    });
  }

  function openStatusModal(meetingId, meetingType, when){
    document.getElementById('statusForm').action = '/lecturer/meetings/' + meetingId + '/status';
    document.getElementById('statusModalTitle').textContent = meetingType;
    document.getElementById('statusModalWhen').textContent = when;
    document.getElementById('statusSelect').value = 'cancelled';
    document.getElementById('statusReason').value = '';
    onStatusChange();
    document.getElementById('statusModal').classList.add('open');
  }

  function onStatusChange(){
    const cancelling = document.getElementById('statusSelect').value === 'cancelled';
    const reason = document.getElementById('statusReason');

    reason.required = cancelling;
    document.getElementById('statusReasonLabel').textContent = cancelling ? 'Reason for cancelling' : 'Note (optional)';
    document.getElementById('statusReasonHint').textContent = cancelling
      ? 'Required. The student sees this on their meetings page.'
      : 'Optional. Recorded against the meeting.';
  }
</script>
{% endblock %}