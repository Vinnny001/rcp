{% extends 'layouts/lecturer.twig' %}

{% block title %}My Profile{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>My profile</h1>
    <div class="sub">Your account details and availability for new supervision or examination work.</div>
  </div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

<div class="section-title">Account<div class="rule"></div></div>

<div class="card" style="margin-bottom:24px;">
  <div class="meta">Name</div>
  <div class="strong" style="margin-bottom:10px;">{{ first_name }} {{ last_name }}</div>

  <div class="meta">Email</div>
  <div class="strong" style="margin-bottom:10px;">{{ user.email ?? '—' }}</div>

  <div class="meta">Phone</div>
  <div class="strong">{{ user.phone ?? '—' }}</div>
</div>

{% if profile %}
  <div class="section-title">Your supervisor profile<div class="rule"></div></div>
  <div class="meta" style="margin-bottom:14px;">
    This is what a student reads before putting you on their shortlist.
    {{ profile.department_name }}{% if profile.specialization %} · {{ profile.specialization }}{% endif %}
  </div>

  <div class="form-card" style="margin-bottom:20px;">
    <form method="POST" action="/lecturer/profile/interests">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field">
        <label>Research interests</label>
        <textarea name="research_interests" rows="4"
                  placeholder="The areas you supervise in, and the kind of work you take on.">{{ profile.research_interests }}</textarea>
      </div>
      <button type="submit" class="btn brass">Save interests</button>
    </form>
  </div>

  <div class="meta" style="margin-bottom:8px;">Where your work can be read</div>

  {% if links %}
    <table style="margin-bottom:14px;">
      <thead><tr><th>Profile</th><th>Address</th><th></th></tr></thead>
      <tbody>
        {% for l in links %}
          <tr>
            <td class="strong">{{ l.label ?: link_platforms[l.platform]|default(l.platform) }}</td>
            <td class="meta" style="word-break:break-all;">
              <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.url }}</a>
            </td>
            <td style="text-align:right;">
              <form method="POST" action="/lecturer/profile/links/remove" style="display:inline;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="link_id" value="{{ l.link_id }}">
                <button type="submit" class="btn ghost" style="padding:4px 10px; font-size:.68rem; color: var(--rust);">Remove</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="notice" style="margin-bottom:14px;">
      No links yet. Students shortlist on what they can read about you, so a Scholar or ResearchGate profile helps them choose well.
    </div>
  {% endif %}

  <div class="form-card" style="margin-bottom:32px;">
    <form method="POST" action="/lecturer/profile/links/add">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field-row">
        <div class="field">
          <label>Where</label>
          <select name="platform" required>
            {% for value, label in link_platforms %}
              <option value="{{ value }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label>Name <span class="meta">— required for "Other"</span></label>
          <input type="text" name="label" maxlength="100" placeholder="e.g. Departmental page">
        </div>
      </div>
      <div class="field">
        <label>Address</label>
        <input type="url" name="url" maxlength="500" placeholder="https://scholar.google.com/citations?user=…" required>
      </div>
      <button type="submit" class="btn brass">Add link</button>
    </form>
  </div>
{% endif %}

<div class="section-title">Supervision &amp; examination<div class="rule"></div></div>

{% if lecturer %}
  <div class="card" style="margin-bottom:24px;">
    <div class="meta">Maximum supervision load</div>
    <div class="strong" style="margin-bottom:14px;">{{ lecturer.max_supervision_load }} student{{ lecturer.max_supervision_load != 1 ? 's' : '' }}</div>

    <div class="meta">Examiner status</div>
    <div style="margin-bottom:14px;">
      <span class="stamp mini {{ lecturer.is_examiner ? 'approved' : 'pending' }}">{{ lecturer.is_examiner ? 'Examiner' : 'Not an examiner' }}</span>
      <span class="meta">— set by the registrar's office, not editable here.</span>
    </div>

    <div class="meta">Availability</div>
    <div style="margin-top:6px;">
      <span class="stamp mini {{ lecturer.is_available ? 'approved' : 'rejected' }}">{{ lecturer.is_available ? 'Available' : 'Unavailable' }}</span>
    </div>

    {% if lecturer.is_available and unavailability_blockers %}
      <div class="notice" style="margin-top:14px;">
        You can turn this off once the following are resolved:
        <ul style="margin:8px 0 0; padding-left:18px;">
          {% for blocker in unavailability_blockers %}
            <li style="font-size:.85rem; line-height:1.6;">{{ blocker }}</li>
          {% endfor %}
        </ul>
      </div>
    {% else %}
      <form method="POST" action="/lecturer/profile/availability" style="margin-top:14px;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" class="btn ghost" style="padding:6px 16px; font-size:.75rem;">
          {{ lecturer.is_available ? 'Turn off availability' : 'Turn on availability' }}
        </button>
      </form>
    {% endif %}
  </div>
{% else %}
  <div class="notice">Your lecturer profile could not be found.</div>
{% endif %}

{% endblock %}
