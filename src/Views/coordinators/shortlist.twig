{% extends 'layouts/lecturer.twig' %}

{% block title %}Supervisor Request{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>{{ shortlist.student_name }}</h1>
    <div class="sub">{{ shortlist.proposal_title }} · {{ shortlist.program_name }}</div>
  </div>
  <div class="ref mono">REQ-{{ shortlist.shortlist_id|slice(0, 8)|upper }}</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

{% if previous %}
  <div class="meta" style="margin-bottom:14px;">
    Follows <a href="/coordinator/shortlists/{{ previous.shortlist_id }}">REQ-{{ previous.shortlist_id|slice(0, 8)|upper }}</a>,
    which was {{ previous.status == 'rejected' ? 'not approved by the department' : 'unsuccessful — nobody was appointed' }}.
    {{ previous.edit_granted_at ? 'The student revised and resent it.' : 'You revised the supervisor list.' }}
  </div>
{% endif %}

<div class="section-title">Proposal as sent<div class="rule"></div></div>
<div class="card" style="margin-bottom:22px;">
  <h3>{{ shortlist.proposal_title }}</h3>
  {% if shortlist.synopsis %}<p style="font-size:.86rem; line-height:1.6; color:#39332a;">{{ shortlist.synopsis }}</p>{% endif %}
  {% if files %}
    <div class="meta" style="margin-bottom:6px;">{% include 'partials/request_files.twig' with {files: files} only %}</div>
  {% else %}
    <div class="meta" style="margin-bottom:6px;">No files were sent with it.</div>
  {% endif %}
  <div class="meta">Sent {{ (shortlist.submitted_at ?: shortlist.created_at)|date('d M Y') }}. Locked — nobody can change it while this request stands.</div>
</div>

<div class="section-title">Supervisors, in the student's order<div class="rule"></div></div>
<table style="margin-bottom:28px;">
  <thead><tr><th>#</th><th>Supervisor</th><th>Status</th></tr></thead>
  <tbody>
    {% for c in choices %}
      <tr>
        <td class="mono">{{ c.rank_position }}</td>
        <td class="strong">
          {{ c.lecturer_user_id == session_user_id ? 'You (' ~ c.lecturer_name ~ ')' : c.lecturer_name }}
          {% if c.is_preferred_main %}<div class="meta" style="font-size:.7rem;">preferred main</div>{% endif %}
        </td>
        <td>
          {% if c.request_status == 'not_sent' %}
            {% if shortlist.status == 'approved' and c.blocker == 'not_internal' %}
              <span class="meta" style="color: var(--rust);">Not an internal lecturer, so cannot supervise — would be passed over if sent now</span>
            {% elseif shortlist.status == 'approved' and c.blocker == 'unavailable' %}
              <span class="meta" style="color: var(--rust);">Not taking new students — would be passed over if sent now</span>
            {% elseif shortlist.status == 'approved' and c.blocker == 'full' %}
              <span class="meta" style="color: var(--rust);">At full load — would be passed over if sent now</span>
            {% else %}
              <span class="meta">Not asked yet</span>
            {% endif %}
          {% elseif c.request_status == 'pending' %}
            <span class="stamp mini pending">Waiting for an answer</span>
          {% elseif c.request_status == 'accepted' %}
            <span class="stamp mini approved">{{ shortlist.status == 'successful' ? 'Appointed' : 'Accepted' }}</span>
          {% elseif c.request_status == 'declined' %}
            <span class="stamp mini rejected">Declined</span>
            {% if c.decline_reason %}<div class="meta" style="font-size:.72rem;">{{ c.decline_reason }}</div>{% endif %}
          {% elseif c.request_status == 'unavailable' %}
            <span class="meta">Could not take a new student</span>
            {% if c.decline_reason %}<div class="meta" style="font-size:.72rem;">{{ c.decline_reason }}</div>{% endif %}
          {% elseif c.request_status == 'expired' %}
            <span class="meta">Did not answer in time</span>
          {% else %}
            <span class="meta">Not needed — higher choices filled the places</span>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{# ---------- no meeting yet ---------- #}
{% if not shortlist.meeting_id %}
  <div class="section-title">Convene the department<div class="rule"></div></div>

  {% if shortlist.proposal_status == 'draft' %}
    <div class="notice">The student is revising the proposal. A meeting can be scheduled once they send it.</div>
  {% else %}
    <div class="meta" style="margin-bottom:14px;">
      Heads vote on the proposal and its supervisor list together. Nothing is sent to any supervisor until the minutes are approved, the decision applied, and you send it.
    </div>

    {% if heads %}
      <div class="form-card">
        <form method="POST" action="/coordinator/shortlists/schedule">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
          <div class="field-row">
            <div class="field"><label>Date and time</label><input type="datetime-local" name="scheduled_at" required></div>
            <div class="field">
              <label>Mode</label>
              <select name="mode">
                <option value="physical">Physical</option>
                <option value="virtual">Virtual</option>
                <option value="hybrid">Hybrid</option>
              </select>
            </div>
          </div>
          <div class="field-row">
            <div class="field"><label>Location</label><input type="text" name="location" placeholder="Boardroom"></div>
            <div class="field"><label>Meeting link</label><input type="url" name="virtual_link" placeholder="https://…"></div>
          </div>

          <div class="field-row">
            <div class="field">
              <label>Meeting lead</label>
              <select name="lead_user_id">
                <option value="">You ({{ first_name }} {{ last_name }})</option>
                {# You are already the first option; naming yourself again would list you twice. #}
                {% for h in heads|filter(h => h.user_id != session_user_id) %}<option value="{{ h.user_id }}">{{ h.head_name }}</option>{% endfor %}
              </select>
            </div>
            <div class="field">
              <label>Secretary <span class="meta">— writes the minutes</span></label>
              <select name="secretary_user_id">
                <option value="">None — the lead writes them</option>
                {% for h in heads %}<option value="{{ h.user_id }}">{{ h.user_id == session_user_id ? 'You (' ~ h.head_name ~ ')' : h.head_name }}</option>{% endfor %}
              </select>
            </div>
          </div>
          <div class="meta" style="margin-bottom:10px;">
            Whoever is secretary writes the minutes. Leave it empty and the lead does — which is you, unless you name someone else as lead.
          </div>

          <label style="font-size:.8rem; display:block; margin:12px 0 6px;">Invite heads of {{ shortlist.department_name }}</label>
          <div style="display:flex; flex-direction:column; gap:6px; margin-bottom:14px;">
            {% for h in heads %}
              <label style="font-size:.82rem; display:flex; gap:8px; align-items:center;">
                <input type="checkbox" name="dept_head_ids[]" value="{{ h.dept_head_id }}" checked>
                {{ h.user_id == session_user_id ? 'You (' ~ h.head_name ~ ')' : h.head_name }} <span class="meta">({{ h.position_name }})</span>
              </label>
            {% endfor %}
          </div>

          <button type="submit" class="btn brass">Schedule meeting</button>
        </form>
      </div>
    {% else %}
      <div class="notice" style="border-left-color: var(--rust); background:#f6eae7;">
        {{ shortlist.department_name }} has no serving heads, so there is nobody to vote. An administrator adds them under Research Roles.
      </div>
    {% endif %}
  {% endif %}

{# ---------- meeting exists ---------- #}
{% else %}
  <div class="section-title">Meeting<div class="rule"></div></div>
  <div class="card" style="margin-bottom:18px;">
    <h3>{{ shortlist.scheduled_at|date('d M Y, g:i A') }}</h3>
    <div class="meta">
      {{ shortlist.mode|capitalize }}{% if shortlist.location %} · {{ shortlist.location }}{% endif %}
      {% if shortlist.virtual_link %} · <a href="{{ shortlist.virtual_link }}" target="_blank" rel="noopener noreferrer">join link</a>{% endif %}
    </div>
  </div>

  <div class="section-title">Votes<div class="rule"></div></div>
  <table style="margin-bottom:18px;">
    <thead><tr><th>Voter</th><th>Position</th><th>Vote</th><th>Comment</th></tr></thead>
    <tbody>
      {% for v in voters %}
        <tr>
          <td class="strong">{{ v.voter_user_id == session_user_id ? 'You (' ~ v.head_name ~ ')' : v.head_name }}</td>
          <td class="meta">{{ v.position_name }}</td>
          <td>
            {% if v.vote == 'approve' %}<span class="stamp mini approved">Approve</span>
            {% elseif v.vote == 'reject' %}<span class="stamp mini rejected">Reject</span>
            {% else %}<span class="meta">Not yet voted</span>{% endif %}
          </td>
          <td class="meta">{{ v.comment }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="meta" style="margin-bottom:16px;">
    {{ tally.approve }} approve · {{ tally.reject }} reject · {{ tally.invited - tally.approve - tally.reject }} yet to vote.
    {% if tally.approve + tally.reject > 0 %}
      As it stands this carries as <span class="strong">{{ tally.outcome == 'approved' ? 'approved' : 'not approved' }}</span>{% if tally.approve == tally.reject %} — a tie does not carry{% endif %}.
    {% endif %}
  </div>

  {# The coordinator votes alongside the heads — once, even if they were
     also invited as a head. Open until the decision is applied. #}
  {% set my_vote = voters|filter(v => v.voter_user_id == session_user_id)|first %}
  {% if my_vote and shortlist.status == 'meeting_scheduled' %}
    <div class="form-card" style="margin-bottom:24px;">
      <div class="meta" style="margin-bottom:8px;">
        Your vote{{ my_vote.capacity == 'head' ? ' — as ' ~ my_vote.position_name : ' — as research coordinator' }}:
        {% if my_vote.vote %}
          <span class="stamp mini {{ my_vote.vote == 'approve' ? 'approved' : 'rejected' }}">{{ my_vote.vote|capitalize }}</span>.
          You can change it until the decision is applied.
        {% else %}
          not cast yet.
        {% endif %}
      </div>
      <form method="POST" action="/coordinator/shortlists/vote">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
        <div class="field">
          <label>Comment (optional)</label>
          <input type="text" name="comment" value="{{ my_vote.comment }}" placeholder="Reason, if you want it in the record">
        </div>
        <div style="display:flex; gap:8px; margin-top:10px;">
          <button type="submit" name="vote" value="approve" class="btn brass">Approve</button>
          <button type="submit" name="vote" value="reject" class="btn ghost" style="color: var(--rust);">Reject</button>
        </div>
      </form>
    </div>
  {% else %}
    <div style="margin-bottom:8px;"></div>
  {% endif %}

  <div class="section-title">Minutes<div class="rule"></div></div>
  <div class="meta" style="margin-bottom:12px;">
    Led by {{ shortlist.lead_user_id == session_user_id ? 'you (' ~ shortlist.lead_name ~ ')' : shortlist.lead_name }}
    {%- if shortlist.secretary_name %}, minuted by {{ shortlist.secretary_user_id == session_user_id ? 'you (' ~ shortlist.secretary_name ~ ')' : shortlist.secretary_name }}{% endif %}.
    {% if not shortlist.minutes_finalized_at %}
      Heads can read the draft as soon as it is saved. Finalising is what unlocks the decision — and cannot be undone.
    {% endif %}
  </div>

  {% if shortlist.minutes_finalized_at %}
    <div style="margin-bottom:22px;">
      {% include 'partials/shortlist_minutes.twig' with {meeting: shortlist} only %}
    </div>
  {% elseif shortlist.minutes_author_id == session_user_id %}
    <div class="form-card" style="margin-bottom:22px;">
      {% include 'partials/shortlist_minutes_form.twig' with {
        meeting: shortlist,
        action: '/coordinator/shortlists/minutes',
        id_field: 'shortlist_id',
        id_value: shortlist.shortlist_id,
        csrf_token: csrf_token
      } only %}
    </div>
  {% else %}
    <div class="notice" style="margin-bottom:22px;">
      {{ shortlist.secretary_name ?: shortlist.lead_name }} writes the minutes for this meeting. You will be able to apply the decision once they finalise them.
      <div style="margin-top:10px;">
        {% include 'partials/shortlist_minutes.twig' with {meeting: shortlist} only %}
      </div>
    </div>
  {% endif %}

  {% if shortlist.status != 'meeting_scheduled' %}
    <div class="notice" style="margin-bottom:24px;">
      Department decision applied — {{ shortlist.status == 'rejected' ? 'not approved' : 'approved' }}.
    </div>

  {% elseif not shortlist.minutes_finalized_at %}
    <div class="notice">
      {{ shortlist.minutes_author_id == session_user_id
         ? 'Finalise the minutes to move this forward.'
         : (shortlist.secretary_name ?: shortlist.lead_name) ~ ' needs to finalise the minutes first.' }}
    </div>

  {% elseif not shortlist.minutes_approved_at %}
    {# Finalised is the author's word for what happened; approving is
       the coordinator accepting it for the program. #}
    <div class="notice" style="margin-bottom:14px;">
      The minutes are finalised and waiting on your approval.
      {% if shortlist.minutes_author_id == session_user_id %}
        You wrote them — approving records that you accept them on behalf of the program.
      {% endif %}
    </div>
    <form method="POST" action="/coordinator/shortlists/approve-minutes">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
      <button type="submit" class="btn brass">Approve the minutes</button>
    </form>

  {% else %}
    <div class="meta" style="margin-bottom:12px;">Minutes approved {{ shortlist.minutes_approved_at|date('d M Y, g:i A') }}.</div>
    <form method="POST" action="/coordinator/shortlists/apply">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
      <button type="submit" class="btn brass"
              onclick="return confirm('Apply the department decision?');">Apply the decision</button>
    </form>
  {% endif %}
{% endif %}

{# ---------- approved: send it ---------- #}
{% if shortlist.status == 'approved' %}
  {% set full = choices|filter(c => c.request_status == 'not_sent' and c.blocker)|length %}
  {% set askable = choices|filter(c => c.request_status == 'not_sent' and not c.blocker)|length %}

  <div class="section-title">Send to the supervisors<div class="rule"></div></div>
  <div class="card">
    <div class="meta" style="margin-bottom:12px;">
      Everyone on the list is asked at the same time and has {{ response_days }} days to answer.
      If more accept than the student has places for, the student's order decides who is appointed.
      It is decided as soon as the result can no longer change, and when the {{ response_days }} days are up at the latest.
    </div>
    <div class="meta" style="margin-bottom:14px;">
      <span class="strong">{{ askable }}</span> will be asked.
      {% if full %}<span style="color: var(--rust);">{{ full }} not taking new students or at full load will be passed over.</span>{% endif %}
    </div>
    <form method="POST" action="/coordinator/shortlists/send">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
      <button type="submit" class="btn brass"
              onclick="return confirm('Send this request to every supervisor on the list now?');">Send to all supervisors</button>
    </form>
  </div>

{# ---------- out with lecturers ---------- #}
{% elseif shortlist.status == 'requests_sent' %}
  <div class="section-title">With the supervisors<div class="rule"></div></div>
  <div class="card">
    <h3>Answers due {{ shortlist.responses_due_at|date('d M Y') }}</h3>
    <div class="meta">
      Sent {{ shortlist.requests_sent_at|date('d M Y') }}.
      {{ choices|filter(c => c.request_status == 'pending')|length }} still to answer ·
      {{ choices|filter(c => c.request_status == 'accepted')|length }} accepted.
      It is decided the moment the student's top choices have answered, and by {{ shortlist.responses_due_at|date('d M Y') }} at the latest.
    </div>
  </div>

{# ---------- done ---------- #}
{% elseif shortlist.status == 'successful' %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">
    Supervisors appointed {{ shortlist.decided_at|date('d M Y') }}.
  </div>

{# ---------- failed: what happens next ---------- #}
{% elseif shortlist.status in ['rejected', 'exhausted'] %}
  <div class="section-title">What happens next<div class="rule"></div></div>

  {% if decision.follow_up %}
    <div class="notice">
      Followed up by <a href="/coordinator/shortlists/{{ decision.follow_up.shortlist_id }}">REQ-{{ decision.follow_up.shortlist_id|slice(0, 8)|upper }}</a>.
      This request stays on record as it ended.
    </div>

  {% elseif decision.grant_open %}
    <div class="notice">
      Handed back to the student on {{ shortlist.edit_granted_at|date('d M Y') }} to revise
      {{- shortlist.edit_proposal_allowed ? ' the proposal' : '' -}}
      {{- shortlist.edit_proposal_allowed and shortlist.edit_shortlist_allowed ? ' and' : '' -}}
      {{- shortlist.edit_shortlist_allowed ? ' the supervisor list' : '' -}}.
      Nothing can be changed or scheduled until they send it.
    </div>

  {% elseif decision.can_decide %}
    <div class="meta" style="margin-bottom:16px;">
      {{ shortlist.status == 'rejected' ? 'The department did not approve this request.' : 'Nobody on the list was appointed.' }}
      Either hand it back to the student, or change the supervisor list yourself. The proposal stays locked unless you hand it back.
    </div>

    <div class="form-card" style="margin-bottom:22px;">
      <h3 style="margin-top:0;">Hand it back to the student</h3>
      <div class="meta" style="margin-bottom:12px;">Only the student can change what you hand back. You cannot change it meanwhile, and no meeting can be scheduled until they send it.</div>
      <form method="POST" action="/coordinator/shortlists/grant-edit">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
        <label style="font-size:.84rem; display:flex; gap:8px; align-items:center; margin-bottom:6px;">
          <input type="checkbox" name="edit_proposal" value="1"> The proposal
        </label>
        <label style="font-size:.84rem; display:flex; gap:8px; align-items:center; margin-bottom:14px;">
          <input type="checkbox" name="edit_shortlist" value="1"> The supervisor list
        </label>
        <button type="submit" class="btn brass">Hand back</button>
      </form>
    </div>

    <div class="form-card">
      <h3 style="margin-top:0;">Revise the supervisor list yourself</h3>
      <div class="meta" style="margin-bottom:14px;">
        This becomes a new request that needs a new department meeting. It is only accepted if the list actually changes.
      </div>
      <form method="POST" action="/coordinator/shortlists/revise" id="reviseForm">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="shortlist_id" value="{{ shortlist.shortlist_id }}">
        {% if supervisors %}
          {% set picker_who = "the student's" %}
          {% include 'partials/supervisor_picker.twig' %}
        {% endif %}
        <button type="submit" name="action" value="revise" class="btn brass" style="margin-top:14px;">Save revised list</button>
      </form>
    </div>
    {% if supervisors %}
      {% set picker_form_id = 'reviseForm' %}
      {% set picker_require_for = ['revise'] %}
      {% include 'partials/supervisor_picker_assets.twig' %}
    {% endif %}
  {% endif %}
{% endif %}

{% endblock %}
