{#
  The minutes of a supervisor-request meeting, read-only, for the people
  who belong to it. Only pages those people can reach include this.

  A draft is shown whole: heads vote against what it says. Once the
  minutes are final the summary leads and the full minutes fold away
  beneath it — typed, as a document, or both.

  Vars: meeting — a row with meeting_id, summary, minutes,
  has_minutes_file, minutes_file_name, minutes_file_size_kb,
  minutes_finalized_at.
#}
{% set document_url = '/lecturer/shortlist-meetings/' ~ meeting.meeting_id ~ '/minutes-document' %}

{% if meeting.minutes_finalized_at %}
  <div style="border:1px solid var(--paper-line); border-radius:var(--radius); background:#fbf8f1; padding:14px 16px;">
    <div class="meta" style="font-size:.72rem;">Meeting summary · minutes finalised {{ meeting.minutes_finalized_at|date('d M Y, g:i A') }}</div>
    {% if meeting.summary %}
      <p style="font-size:.88rem; line-height:1.6; white-space:pre-wrap; margin:6px 0 0;">{{ meeting.summary }}</p>
    {% else %}
      <p class="meta" style="margin:6px 0 0;">These minutes were finalised before meetings had summaries. One is written from the vote when the decision is applied.</p>
    {% endif %}

    {% if meeting.minutes or meeting.has_minutes_file %}
      <details style="margin-top:12px;" {{ meeting.summary ? '' : 'open' }}>
        <summary style="cursor:pointer; font-size:.84rem; font-weight:600;">
          Full minutes <span class="meta" style="font-weight:400;">— for the people at this meeting only</span>
        </summary>
        {% if meeting.has_minutes_file %}
          <div style="font-size:.84rem; margin-top:10px;">
            <a href="{{ document_url }}" target="_blank" rel="noopener">{{ meeting.minutes_file_name }}</a>
            <span class="meta">· {{ meeting.minutes_file_size_kb }} KB</span>
          </div>
        {% endif %}
        {% if meeting.minutes %}
          <p style="font-size:.85rem; line-height:1.6; white-space:pre-wrap; margin:10px 0 0;">{{ meeting.minutes }}</p>
        {% endif %}
      </details>
    {% endif %}
  </div>

{% elseif meeting.summary or meeting.minutes or meeting.has_minutes_file %}
  <div class="meta" style="font-size:.72rem;">Minutes <span style="color: var(--rust);">(draft — may still change)</span></div>
  {% if meeting.summary %}
    <p style="font-size:.85rem; line-height:1.6; white-space:pre-wrap; margin:6px 0 0;"><span class="strong">Summary:</span> {{ meeting.summary }}</p>
  {% endif %}
  {% if meeting.has_minutes_file %}
    <div style="font-size:.84rem; margin-top:6px;">
      <a href="{{ document_url }}" target="_blank" rel="noopener">{{ meeting.minutes_file_name }}</a>
      <span class="meta">· {{ meeting.minutes_file_size_kb }} KB</span>
    </div>
  {% endif %}
  {% if meeting.minutes %}
    <p style="font-size:.85rem; line-height:1.6; white-space:pre-wrap; margin:6px 0 0;">{{ meeting.minutes }}</p>
  {% endif %}

{% else %}
  <div class="meta">No minutes have been written yet.</div>
{% endif %}
