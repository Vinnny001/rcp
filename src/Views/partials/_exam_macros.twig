{#
  Student-facing examination card.

  Deliberately shows no numbers: no overall_grade, no grade_letter, and
  no per-examiner score. A student sees the outcome band and the
  examiners' written comments only — the marks behind that decision stay
  in the lecturer and admin areas.
#}
{% macro exam_card(title, exam, proposal_approved) %}
  <div class="card">
    <h3>{{ title }}</h3>
    {% if exam %}
      <div class="meta">{{ exam.exam_date ? exam.exam_date|date('d M Y') : 'Date to be confirmed' }}</div>

      {% if exam.outcome %}
        <span class="stamp mini {{ exam.stamp_class|default('pending') }}">{{ exam.outcome_label|default(exam.outcome|capitalize) }}</span>
      {% elseif exam.pending_graders is defined and exam.pending_graders > 0 %}
        <span class="stamp mini pending">
          Awaiting {{ exam.pending_graders }} examiner{{ exam.pending_graders != 1 ? 's' : '' }}
        </span>
      {% else %}
        <span class="stamp mini pending">Awaiting grading</span>
      {% endif %}

      {% if exam.graders %}
        <div class="meta" style="margin-top:10px;">
          Examiners:
          {% for g in exam.graders %}
            {{ g.name }} ({{ g.examiner_type }}){% if not loop.last %}, {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if exam.examiner_comments %}
        <p style="font-size:.85rem; line-height:1.6; color:#39332a; margin-top:10px;">{{ exam.examiner_comments }}</p>
      {% endif %}
    {% else %}
      <div class="meta">Not yet scheduled</div>
      <span class="stamp mini pending">{{ proposal_approved ? 'Pending scheduling' : 'Awaiting proposal approval' }}</span>
    {% endif %}
  </div>
{% endmacro %}
