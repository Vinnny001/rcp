<script>
  function chatReplyTo(chatId, snippet) {
    var input = document.getElementById('chatReplyToInput');
    if (!input) return;
    input.value = chatId;
    document.getElementById('chatReplyText').textContent = snippet;
    document.getElementById('chatReplyBanner').style.display = 'block';
  }
  function chatCancelReply() {
    document.getElementById('chatReplyToInput').value = '';
    document.getElementById('chatReplyBanner').style.display = 'none';
  }
  function chatShowInfo(event, chatId, fallbackSentAt, fallbackReadAt) {
    event.preventDefault();
    // A "mine" bubble's tick span is the live-updated source of truth
    // for read state; fall back to what was baked in at render time for
    // a bubble that never gets one (the other party's messages).
    var tick = document.getElementById('tick-' + chatId);
    var sentAt = (tick && tick.dataset.createdAt) || fallbackSentAt;
    var readAt = (tick && tick.dataset.readAt) || fallbackReadAt;
    var pop = document.getElementById('chatInfoPopover');
    pop.innerHTML = 'Sent: ' + (sentAt ? chatFormatTimestamp(sentAt) : 'unknown')
      + '<br>Read: ' + (readAt ? chatFormatTimestamp(readAt) : 'Not read yet');
    pop.style.left = event.clientX + 'px';
    pop.style.top = event.clientY + 'px';
    pop.style.display = 'block';
    document.addEventListener('click', chatHideInfoOnce);
    return false;
  }
  function chatHideInfoOnce() {
    document.getElementById('chatInfoPopover').style.display = 'none';
    document.removeEventListener('click', chatHideInfoOnce);
  }
  function chatComposeKeydown(event, textarea) {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      var form = textarea.form;
      if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
    }
  }
  // Keep the log scrolled to the newest message on load.
  (function() {
    var log = document.getElementById('chatLog');
    if (log) log.scrollTop = log.scrollHeight;
  })();

  // --- Real-time chat over the rcp_messaging WebSocket server ---------
  // Mirrors _chat_thread.twig's bubble markup and Chat::linkify() so a
  // message that arrives live looks identical to one rendered on page
  // load. The <form> below still posts normally (chatModel->sendMessage)
  // as a no-JS / WS-unavailable fallback — it's only intercepted once a
  // live, authenticated socket exists. The connection itself belongs to
  // window.RcpChat (see _chat_client.twig, included once by the layout)
  // — this file only listens and sends, so opening this page never
  // creates a second socket alongside the layout's site-wide one.

  function chatEscapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function chatLinkify(text) {
    var urlPattern = /(https?:\/\/[^\s<]+)/gi;
    var telPattern = /(\+?\d[\d\-\s]{6,}\d)/g;
    var segments = text.split(urlPattern);
    var html = '';

    segments.forEach(function(segment, i) {
      if (i % 2 === 1) {
        var trailing = '';
        var m = segment.match(/([.,;:!?)]+)$/);
        if (m) {
          trailing = m[1];
          segment = segment.slice(0, segment.length - trailing.length);
        }
        var escapedUrl = chatEscapeHtml(segment);
        html += '<a href="' + escapedUrl + '" target="_blank" rel="noopener noreferrer">' + escapedUrl + '</a>' + chatEscapeHtml(trailing);
        return;
      }

      html += chatEscapeHtml(segment).replace(telPattern, function(match) {
        var digitCount = match.replace(/\D/g, '').length;
        if (digitCount < 7) return match;
        var href = match.replace(/[^\d+]/g, '');
        return '<a href="tel:' + href + '">' + match + '</a>';
      });
    });

    return html;
  }

  function chatFormatTimestamp(iso) {
    var d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var hours = d.getHours();
    var ampm = hours >= 12 ? 'PM' : 'AM';
    var h12 = hours % 12 || 12;
    var minutes = ('0' + d.getMinutes()).slice(-2);
    return ('0' + d.getDate()).slice(-2) + ' ' + months[d.getMonth()] + ', ' + h12 + ':' + minutes + ' ' + ampm;
  }

  // Tick state only ever moves forward (sent -> delivered -> read) —
  // rank-gating every write means an out-of-order or duplicate event
  // (e.g. a 'delivered' notification arriving after a 'read_receipt'
  // already upgraded the same bubble) can never regress a tick.
  function chatTickRank(state) {
    return state === 'read' ? 2 : (state === 'delivered' ? 1 : 0);
  }

  function chatTickVisual(state) {
    return {
      text: state === 'sent' ? '✓' : '✓✓',
      color: state === 'read' ? '#3b82f6' : 'inherit',
    };
  }

  function chatSetTickState(tick, state, readAtIso) {
    if (chatTickRank(state) <= chatTickRank(tick.dataset.state)) return;
    var visual = chatTickVisual(state);
    tick.textContent = visual.text;
    tick.style.color = visual.color;
    tick.dataset.state = state;
    if (readAtIso) tick.dataset.readAt = readAtIso;
  }

  function chatUpgradeAllTicks(scopeEl, state) {
    var nowIso = new Date().toISOString();
    scopeEl.querySelectorAll('[id^="tick-"]').forEach(function(tick) {
      chatSetTickState(tick, state, state === 'read' ? nowIso : null);
    });
  }

  function chatUpgradeTicksUpTo(scopeEl, upToIso) {
    var upTo = new Date(upToIso).getTime();
    scopeEl.querySelectorAll('[id^="tick-"]').forEach(function(tick) {
      if (new Date(tick.dataset.createdAt).getTime() <= upTo) {
        chatSetTickState(tick, 'delivered', null);
      }
    });
  }

  function chatRenderBubble(msg, myUserId, partnerLabel) {
    var mine = msg.sender_user_id === myUserId;

    var row = document.createElement('div');
    row.style.cssText = 'display:flex; justify-content:' + (mine ? 'flex-end' : 'flex-start') + '; margin-bottom:10px;';

    var bubble = document.createElement('div');
    bubble.className = 'chat-bubble';
    bubble.style.cssText = 'max-width:70%; padding:8px 12px; border-radius:10px; cursor:pointer;'
      + 'background:' + (mine ? 'var(--brass-deep, #a9702f)' : 'var(--paper-warm, #f2ede2)') + ';'
      + 'color:' + (mine ? '#fff' : 'inherit') + ';';

    if (msg.reply_to_chat_id && msg.reply_message) {
      var quote = document.createElement('div');
      quote.style.cssText = 'font-size:.72rem; opacity:.8; border-left:2px solid currentColor; padding-left:6px; margin-bottom:4px;';
      quote.textContent = (msg.reply_sender_id === myUserId ? 'You' : partnerLabel) + ': ' + msg.reply_message.slice(0, 80);
      bubble.appendChild(quote);
    }

    var body = document.createElement('div');
    body.style.cssText = 'font-size:.86rem; white-space:pre-wrap;';
    body.innerHTML = chatLinkify(msg.message);
    bubble.appendChild(body);

    var meta = document.createElement('div');
    meta.style.cssText = 'font-size:.65rem; opacity:.7; margin-top:4px; text-align:right;';
    meta.textContent = chatFormatTimestamp(msg.created_at);
    bubble.appendChild(meta);

    if (mine) {
      var state = msg.read_at ? 'read' : (msg.delivered_at ? 'delivered' : 'sent');
      var visual = chatTickVisual(state);
      var tick = document.createElement('span');
      tick.id = 'tick-' + msg.chat_id;
      tick.dataset.state = state;
      tick.dataset.createdAt = msg.created_at;
      tick.dataset.readAt = msg.read_at || '';
      tick.style.marginLeft = '4px';
      tick.style.color = visual.color;
      tick.textContent = visual.text;
      meta.appendChild(tick);
    }

    bubble.addEventListener('dblclick', function() {
      chatReplyTo(msg.chat_id, msg.message.slice(0, 80));
    });
    bubble.addEventListener('contextmenu', function(event) {
      return chatShowInfo(event, msg.chat_id, msg.created_at, msg.read_at || '');
    });

    row.appendChild(bubble);
    return row;
  }

  (function() {
    if (!window.RcpChat) return;

    // Presence dots apply to every thread in the sidebar, not just
    // whichever one is currently open, so this listener is registered
    // unconditionally rather than inside the "is a thread selected?"
    // guard below.
    RcpChat.on('presence', function(data) {
      var dot = document.getElementById('presenceDot-' + data.user_id);
      if (!dot) return;
      dot.style.background = data.online ? '#2ecc71' : '#c7c2b4';
      dot.title = data.online ? 'Online' : 'Offline';
    });

    var log = document.getElementById('chatLog');
    if (!log) return;

    var partnerUserId = log.dataset.partnerUserId;
    if (!partnerUserId) return;

    var myUserId = RcpChat.myUserId;
    var role = RcpChat.role;
    var partnerLabel = log.dataset.partnerLabel;
    var canSend = log.dataset.canSend === '1';
    var studentUserId = role === 'student' ? myUserId : partnerUserId;
    var lecturerUserId = role === 'lecturer' ? myUserId : partnerUserId;

    function sameConversation(msg) {
      return msg.student_user_id === studentUserId && msg.lecturer_user_id === lecturerUserId;
    }

    function appendMessage(msg) {
      if (log.dataset.empty === '1') {
        log.innerHTML = '';
        log.dataset.empty = '0';
      }
      log.appendChild(chatRenderBubble(msg, myUserId, partnerLabel));
      log.scrollTop = log.scrollHeight;
    }

    function markRead() {
      RcpChat.send({ type: 'read', student_user_id: studentUserId, lecturer_user_id: lecturerUserId });
      // The badge for this thread may already be stale-zero from the
      // page-load render (see StudentChatController::show ordering);
      // this keeps the sidebar in sync regardless.
      RcpChat.clearThreadBadge(partnerUserId);
    }

    RcpChat.on('auth_ok', markRead);

    RcpChat.on('message', function(data) {
      if (!sameConversation(data)) return;
      appendMessage(data);
      if (data.sender_user_id !== myUserId) markRead();
    });

    // The other party opened this thread — every tick on my own
    // messages here can jump straight to "read" (skipping "delivered"
    // if it hadn't already arrived).
    RcpChat.on('read_receipt', function(data) {
      if (!sameConversation(data)) return;
      chatUpgradeAllTicks(log, 'read');
    });

    // The other party just came back online — any of my messages sent
    // before they connected (created_at <= up_to) move from "sent" to
    // "delivered".
    RcpChat.on('delivered', function(data) {
      if (!sameConversation(data)) return;
      chatUpgradeTicksUpTo(log, data.up_to);
    });

    RcpChat.on('error', function(data) {
      console.error('[chat]', data.code);
      if (data.code === 'send_failed' || data.code === 'forbidden' || data.code === 'not_active_supervision' || data.code === 'server_error') {
        alert('Your message could not be sent (' + data.code.replace(/_/g, ' ') + '). Please try again.');
      }
    });

    var form = document.getElementById('chatSendForm');
    if (canSend && form) {
      form.addEventListener('submit', function(event) {
        if (!RcpChat.isAuthed()) return; // no live socket — fall back to the normal POST
        event.preventDefault();

        var textarea = form.querySelector('textarea[name="message"]');
        var message = textarea.value.trim();
        if (!message) return;

        var replyInput = document.getElementById('chatReplyToInput');
        RcpChat.send({
          type: 'send',
          student_user_id: studentUserId,
          lecturer_user_id: lecturerUserId,
          message: message,
          reply_to_chat_id: replyInput.value || null,
        });

        textarea.value = '';
        chatCancelReply();
      });
    }
  })();
</script>
