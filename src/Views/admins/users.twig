{% extends 'layouts/admin.twig' %}

{% block title %}Users{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Users</h1>
    <div class="sub">Every account on the platform, with the roles it currently holds.</div>
  </div>
  <div class="ref">USR-REGISTRY</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

<div class="section-title">All accounts<div class="rule"></div></div>

<form method="GET" action="/admin/users" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
  <input type="text" name="q" value="{{ q }}" placeholder="Search name, email, student number…" style="min-width:240px;">

  <select name="role">
    <option value="">All roles</option>
    {% for role in roles %}
      <option value="{{ role.role_name }}" {{ role_filter == role.role_name ? 'selected' : '' }}>{{ role.role_name|capitalize }}</option>
    {% endfor %}
  </select>

  <button type="submit" class="btn ghost" style="padding:6px 14px; font-size:.72rem;">Filter</button>
  {% if q or role_filter %}
    <a href="/admin/users" class="meta" style="font-size:.75rem;">Clear filters</a>
  {% endif %}
</form>

{% if users %}
  <table>
    <thead>
      <tr><th>Name</th><th>Roles</th><th>Department</th><th>Last login</th><th>Status</th><th>Examiner</th><th>Supervision load</th><th>Affiliation</th><th>Manage roles</th><th></th></tr>
    </thead>
    <tbody>
      {% for u in users %}
        {% set held = roles_by_user[u.user_id]|default([]) %}
        <tr>
          <td class="strong">
            {{ u.first_name }} {{ u.last_name }}
            <div class="meta" style="margin:2px 0 0;">{{ u.email }}{% if u.student_number %} · {{ u.student_number }}{% endif %}</div>
          </td>
          <td>
            {% if held %}
              {% for role in held %}<span class="stamp mini approved" style="margin-right:4px;">{{ role|capitalize }}</span>{% endfor %}
            {% else %}
              <span class="stamp mini pending">No roles</span>
            {% endif %}
          </td>
          <td>{{ u.department ?? '—' }}</td>
          <td class="mono">{{ u.last_login ? u.last_login|date('d M Y') : 'Never' }}</td>
          <td>
            {% if u.is_active %}
              <span class="stamp mini approved">Active</span>
            {% else %}
              <span class="stamp mini rejected">Suspended</span>
            {% endif %}
          </td>
          <td>
            {% if u.lecturer_id %}
              <form method="POST" action="/admin/users/toggle-examiner" style="display:flex; gap:6px; align-items:center;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="lecturer_id" value="{{ u.lecturer_id }}">
                <span class="stamp mini {{ u.is_examiner ? 'approved' : 'pending' }}">{{ u.is_examiner ? 'Examiner' : 'Not examiner' }}</span>
                <button type="submit" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">Toggle</button>
              </form>
            {% else %}
              <span class="meta">—</span>
            {% endif %}
          </td>
          <td>
            {% if u.lecturer_id %}
              <form method="POST" action="/admin/users/max-supervision-load" style="display:flex; gap:6px; align-items:center;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="lecturer_id" value="{{ u.lecturer_id }}">
                <input type="number" name="max_supervision_load" value="{{ u.max_supervision_load }}" min="0" style="width:64px;">
                <button type="submit" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">Save</button>
              </form>
            {% else %}
              <span class="meta">—</span>
            {% endif %}
          </td>
          <td style="min-width:220px;">
            {% if u.lecturer_id %}
              {% set aff = affiliations[u.lecturer_id] %}
              <div class="meta" style="margin-bottom:4px;">
                {% if aff and aff.type == 'internal' %}
                  <span class="stamp mini approved">Internal</span> {{ aff.department_name ?? '—' }} · {{ aff.staff_number }}
                {% elseif aff and aff.type == 'external' %}
                  <span class="stamp mini pending">External</span> {{ aff.institution ?? '—' }}
                {% else %}
                  <span class="stamp mini rejected">Not set</span>
                {% endif %}
              </div>
              {% set formId = 'aff-' ~ u.user_id %}
              <form method="POST" action="/admin/users/affiliation" style="display:flex; flex-direction:column; gap:4px;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="lecturer_id" value="{{ u.lecturer_id }}">
                <select name="affiliation_type" style="width:100%;"
                        onchange="document.getElementById('{{ formId }}-internal').style.display = this.value=='internal' ? 'flex' : 'none'; document.getElementById('{{ formId }}-external').style.display = this.value=='external' ? 'flex' : 'none';">
                  <option value="internal" {{ (aff.type ?? '') == 'internal' ? 'selected' : '' }}>Internal</option>
                  <option value="external" {{ (aff.type ?? '') == 'external' ? 'selected' : '' }}>External</option>
                </select>

                <div id="{{ formId }}-internal" style="display:{{ (aff.type ?? 'internal') == 'internal' ? 'flex' : 'none' }}; flex-direction:column; gap:4px;">
                  <input type="text" name="staff_number" placeholder="Staff number" value="{{ aff.staff_number ?? '' }}" style="width:100%;">
                  <select name="department_id" style="width:100%;">
                    <option value="">-- Department --</option>
                    {% for d in departments %}
                      <option value="{{ d.department_id }}" {{ (aff.department_id ?? '') == d.department_id ? 'selected' : '' }}>{{ d.name }}</option>
                    {% endfor %}
                  </select>
                </div>

                <div id="{{ formId }}-external" style="display:{{ (aff.type ?? '') == 'external' ? 'flex' : 'none' }}; flex-direction:column; gap:4px;">
                  <input type="text" name="non_staff_number" placeholder="Non-staff number" value="{{ aff.non_staff_number ?? '' }}" style="width:100%;">
                  <input type="text" name="institution" placeholder="Institution" value="{{ aff.institution ?? '' }}" style="width:100%;">
                  <input type="text" name="department" placeholder="Department" value="{{ aff.department ?? '' }}" style="width:100%;">
                </div>

                <input type="text" name="specialization" placeholder="Specialization (optional)" value="{{ aff.specialization ?? '' }}" style="width:100%;">

                <button type="submit" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">Save affiliation</button>
              </form>
            {% else %}
              <span class="meta">—</span>
            {% endif %}
          </td>
          <td>
            <form method="POST" action="/admin/users/role" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
              <input type="hidden" name="user_id" value="{{ u.user_id }}">

              <select name="role_id" required style="min-width:120px;">
                {% for role in roles %}
                  <option value="{{ role.role_id }}">{{ role.role_name|capitalize }}</option>
                {% endfor %}
              </select>

              <select name="action" required style="min-width:100px;">
                <option value="grant">Grant</option>
                <option value="revoke">Revoke</option>
              </select>

              <button type="submit" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">Apply</button>
            </form>
          </td>
          <td>
            <form method="POST" action="/admin/users/toggle" style="display:inline;">
              <input type="hidden" name="user_id" value="{{ u.user_id }}">
              <button type="submit" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">
                {{ u.is_active ? 'Suspend' : 'Reactivate' }}
              </button>
            </form>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="notice" style="margin-top:18px;">
    Roles are additive — a user can hold several and picks which one to sign in as. Granting <span class="mono">lecturer</span> or <span class="mono">student</span> also creates the matching profile record if the user doesn't have one. A newly created lecturer won't appear in examiner invite lists until their internal or external affiliation is recorded.
  </div>
{% else %}
  <div class="notice">{{ q or role_filter ? 'No users match your filters.' : 'No users found.' }}</div>
{% endif %}

{% endblock %}
