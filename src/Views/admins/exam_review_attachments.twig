{% extends 'layouts/admin.twig' %}

{% block title %}Review Attachments{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Review attachments</h1>
    <div class="sub">Supporting documents examiners have attached to explain a score — admin-facing only.</div>
  </div>
  <div class="ref">REVIEW-DOCS</div>
</div>

<div class="section-title">Exam window document reviews<div class="rule"></div></div>

{% if attachments %}
  <table style="margin-bottom:32px;">
    <thead>
      <tr><th>Student</th><th>Proposal</th><th>Thesis schedule</th><th>Exam window</th><th>Meeting</th><th>Document under review</th><th>Examiner</th><th>Evidence file</th><th>Uploaded</th></tr>
    </thead>
    <tbody>
      {% for a in attachments %}
        <tr>
          <td class="strong">{{ a.student_name }}<div class="meta" style="margin:2px 0 0;">{{ a.student_number }}</div></td>
          <td>{{ a.proposal_title }}</td>
          <td class="mono">{{ a.program_name }}<div class="meta" style="margin:2px 0 0;">{{ a.enrollment_start_date ? a.enrollment_start_date|date('d M Y') : '—' }} – {{ a.enrollment_end_date ? a.enrollment_end_date|date('d M Y') : '—' }}</div></td>
          <td class="mono">{{ a.exam_type|capitalize }} · {{ a.starts_at ? a.starts_at|date('d M Y') : '—' }}</td>
          <td class="mono">{{ a.meeting_type|replace({'_': ' '})|capitalize }}<div class="meta" style="margin:2px 0 0;">{{ a.scheduled_at|date('d M Y H:i') }}</div></td>
          <td>{{ a.doc_type_name }}<div class="meta" style="margin:2px 0 0;"><a href="/{{ a.reviewed_file_path }}" target="_blank">{{ a.reviewed_file_name }}</a></div></td>
          <td>{{ a.examiner_name }}</td>
          <td><a href="/{{ a.file_path }}" target="_blank" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">{{ a.file_name }}</a></td>
          <td class="mono">{{ a.created_at|date('d M Y H:i') }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice" style="margin-bottom:32px;">No exam-window review attachments have been uploaded yet.</div>
{% endif %}

<div class="section-title">General (non-exam) document reviews<div class="rule"></div></div>

{% if document_review_attachments %}
  <table>
    <thead>
      <tr><th>Student</th><th>Proposal</th><th>Thesis schedule</th><th>Meeting</th><th>Document(s) under review</th><th>Examiner</th><th>Evidence file</th><th>Uploaded</th></tr>
    </thead>
    <tbody>
      {% for a in document_review_attachments %}
        <tr>
          <td class="strong">{{ a.student_name }}<div class="meta" style="margin:2px 0 0;">{{ a.student_number }}</div></td>
          <td>{{ a.proposal_title }}</td>
          <td class="mono">{{ a.program_name ?? '—' }}<div class="meta" style="margin:2px 0 0;">{{ a.enrollment_start_date ? a.enrollment_start_date|date('d M Y') : '—' }} – {{ a.enrollment_end_date ? a.enrollment_end_date|date('d M Y') : '—' }}</div></td>
          <td class="mono">{{ a.meeting_type|replace({'_': ' '})|capitalize }}<div class="meta" style="margin:2px 0 0;">{{ a.scheduled_at|date('d M Y H:i') }}</div></td>
          <td>{{ a.reviewed_file_names ?? '—' }}</td>
          <td>{{ a.examiner_name }}</td>
          <td><a href="/{{ a.file_path }}" target="_blank" class="btn ghost" style="padding:5px 12px; font-size:.72rem;">{{ a.file_name }}</a></td>
          <td class="mono">{{ a.created_at|date('d M Y H:i') }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice">No general document review attachments have been uploaded yet.</div>
{% endif %}

{% endblock %}
