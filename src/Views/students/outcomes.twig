{% extends 'layouts/student.twig' %}

{% block title %}My Results{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>My results</h1>
    <div class="sub">Examination outcomes and document review decisions, as recorded by your examiners.</div>
  </div>
  <div class="ref">RES-{{ student_number }}</div>
</div>

<div class="notice" style="margin-bottom:32px;">
  Results are reported as an outcome rather than a mark. Each outcome is the band your examiners' average score falls into — the individual scores are not part of your record here.
</div>

<div class="section-title">Examination outcomes<div class="rule"></div></div>

{% if exam_outcomes %}
  {% for group in exam_outcomes %}
    <div style="margin-bottom:28px;">
      {% if group.proposal_title %}
        <div class="meta" style="margin-bottom:10px;">{{ group.proposal_title }}</div>
      {% endif %}

      <div class="grid cols-2">
        {% for exam in group.examinations %}
          <div class="card">
            <h3>{{ exam.exam_type|capitalize }} examination</h3>
            <div class="meta">{{ exam.exam_date ? exam.exam_date|date('d M Y') : 'Date to be confirmed' }}</div>

            {% if exam.outcome %}
              <span class="stamp mini {{ exam.stamp_class }}">{{ exam.outcome_label }}</span>
            {% elseif exam.pending_graders > 0 %}
              <span class="stamp mini pending">
                Awaiting {{ exam.pending_graders }} examiner{{ exam.pending_graders != 1 ? 's' : '' }}
              </span>
            {% else %}
              <span class="stamp mini pending">Awaiting grading</span>
            {% endif %}

            {% if exam.graders %}
              <div class="meta" style="margin-top:10px;">
                Examiners:
                {% for g in exam.graders %}
                  {{ g.name }} ({{ g.examiner_type }}){% if not loop.last %}, {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if exam.examiner_comments %}
              <p style="font-size:.85rem; line-height:1.6; color:#39332a; margin-top:10px;">{{ exam.examiner_comments }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}

  <div class="meta" style="margin-bottom:32px;">
    Examination scale:
    {% for band in exam_scale %}{{ band.label }} ({{ band.range }}){% if not loop.last %} · {% endif %}{% endfor %}
  </div>
{% else %}
  <div class="notice" style="margin-bottom:32px;">
    No examination results yet. Outcomes appear here once every assigned examiner has submitted their assessment.
  </div>
{% endif %}

<div class="section-title">Document review outcomes<div class="rule"></div></div>

{% if document_outcomes %}
  <table style="margin-bottom:18px;">
    <thead>
      <tr><th>Document</th><th>Type</th><th>Reviewed</th><th>Reviewers</th><th>Outcome</th></tr>
    </thead>
    <tbody>
      {% for doc in document_outcomes %}
        <tr>
          <td class="strong">{{ doc.file_name }}</td>
          <td class="mono">{{ doc.doc_type_name }}</td>
          <td class="mono">{{ doc.last_reviewed_at ? doc.last_reviewed_at|date('d M Y') : '—' }}</td>
          <td class="mono">{{ doc.reviewer_count }}</td>
          <td><span class="stamp mini {{ doc.stamp_class }}">{{ doc.outcome_label }}</span></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {% for doc in document_outcomes %}
    {% if doc.comments %}
      <div class="card" style="margin-bottom:14px;">
        <h3>Feedback on {{ doc.file_name }}</h3>
        {% for comment in doc.comments %}
          <p style="font-size:.85rem; line-height:1.6; color:#39332a; margin-top:8px;">{{ comment }}</p>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

  <div class="meta">
    Document review scale:
    {% for band in document_scale %}{{ band.label }} ({{ band.range }}){% if not loop.last %} · {% endif %}{% endfor %}
  </div>
{% else %}
  <div class="notice">
    None of your documents have been reviewed yet. A decision appears here once an examiner or your supervisor reviews a document in a meeting.
  </div>
{% endif %}

{% endblock %}
