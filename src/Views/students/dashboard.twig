<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dashboard — RCP</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/student.css">
</head>
<body>

<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">RC</div>
      <div class="brand-text">
        <div class="t1">Research Coordination Platform</div>
        <div class="t2">Registrar's Dossier System</div>
      </div>
    </div>
    <div class="user-chip">
      <div class="who">
        <div class="name">{{ first_name }}</div>
        <div class="role">Student</div>
        <form method="POST" action="/logout" style="display:inline;">
          <button type="submit" class="logout-link">Sign out</button>
        </form>
      </div>
      <div class="avatar">{{ first_name|slice(0,1)|upper }}</div>
    </div>
  </header>

  <aside class="sidebar">
    <nav class="tabs">
      <a class="tab active" href="/student/dashboard"><span class="num">01</span>Overview</a>
      <a class="tab" href="/student/proposal"><span class="num">02</span>Thesis Proposal</a>
      <a class="tab" href="/student/requirements"><span class="num">03</span>Requirements</a>
      <a class="tab" href="/student/meetings"><span class="num">04</span>Meetings</a>
      <a class="tab" href="/student/exam"><span class="num">05</span>Exam &amp; Graduation</a>
    </nav>
    <div class="sidebar-foot">RCP v1<br>JKUAT Graduate School</div>
  </aside>

  <main class="content">
    <div class="page-head">
      <div>
        <h1>Your dossier</h1>
        <div class="sub">Track where your thesis stands, from registration through to graduation.</div>
      </div>
      <div class="ref">STUDENT DASHBOARD</div>
    </div>

    <div class="rail">
      <div class="rail-step done"><div class="line"></div><div class="dot">1</div><div class="label">Registration</div></div>
      <div class="rail-step current"><div class="line"></div><div class="dot">2</div><div class="label">Requirements<br>Validation</div></div>
      <div class="rail-step"><div class="line"></div><div class="dot">3</div><div class="label">Proposal<br>Approval</div></div>
      <div class="rail-step"><div class="line"></div><div class="dot">4</div><div class="label">Concept<br>Presentation</div></div>
      <div class="rail-step"><div class="line"></div><div class="dot">5</div><div class="label">Examination</div></div>
      <div class="rail-step"><div class="line"></div><div class="dot">6</div><div class="label">Graduation</div></div>
    </div>

    <div class="grid cols-3">
      <div class="card">
        <h3>Proposal status</h3>
        <div class="meta">No proposal submitted yet</div>
        <span class="stamp pending">Not started</span>
      </div>
      <div class="card">
        <h3>Outstanding balance</h3>
        <div class="stat">—</div>
        <div class="stat-label">No pending fees on record</div>
      </div>
      <div class="card">
        <h3>Supervisor</h3>
        <div class="meta">Not yet assigned</div>
      </div>
    </div>

    <div class="section-title">Next meeting<div class="rule"></div></div>
    <div class="card">
      <div class="meta">No meetings scheduled yet.</div>
    </div>
  </main>
</div>

</body>
</html>