{% extends 'layouts/student.twig' %}

{% block title %}Overview{% endblock %}

{% block content %}
  <div class="page-head">
    <div>
      <h1>Your dossier</h1>
      <div class="sub">Track where your thesis stands, from registration through to graduation.</div>
    </div>
    <div class="ref">STUDENT DASHBOARD</div>
  </div>

  <div class="rail">
    <div class="rail-step done"><div class="line"></div><div class="dot">1</div><div class="label">Registration</div></div>
    <div class="rail-step current"><div class="line"></div><div class="dot">2</div><div class="label">Requirements<br>Validation</div></div>
    <div class="rail-step"><div class="line"></div><div class="dot">3</div><div class="label">Proposal<br>Approval</div></div>
    <div class="rail-step"><div class="line"></div><div class="dot">4</div><div class="label">Concept<br>Presentation</div></div>
    <div class="rail-step"><div class="line"></div><div class="dot">5</div><div class="label">Examination</div></div>
    <div class="rail-step"><div class="line"></div><div class="dot">6</div><div class="label">Graduation</div></div>
  </div>

  <div class="grid cols-3">
    <div class="card">
      <h3>Proposal status</h3>
      <div class="meta">No proposal submitted yet</div>
      <span class="stamp pending">Not started</span>
    </div>
    <div class="card">
      <h3>Outstanding balance</h3>
      <div class="stat">—</div>
      <div class="stat-label">No pending fees on record</div>
    </div>
    <div class="card">
      <h3>Supervisor</h3>
      <div class="meta">Not yet assigned</div>
    </div>
  </div>

  <div class="section-title">Next meeting<div class="rule"></div></div>
  <div class="card">
    <div class="meta">No meetings scheduled yet.</div>
  </div>
{% endblock %}