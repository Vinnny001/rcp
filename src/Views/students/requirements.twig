{% extends 'layouts/student.twig' %}

{% block title %}Requirements{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Requirements</h1>
    <div class="sub">Documents and payments needed to move your file forward.</div>
  </div>
  <div class="ref">REQ-{{ student_number }}</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

<div class="section-title">
  Documents<div class="rule"></div>
  <button class="btn ghost" style="padding:6px 14px; font-size:.74rem;" onclick="openModal('uploadModal')">Upload document</button>
</div>

{% if documents %}
  <table style="margin-bottom:32px;">
    <thead><tr><th>File</th><th>Type</th><th>Uploaded</th><th>Status</th></tr></thead>
    <tbody>
      {% for doc in documents %}
        <tr>
          <td class="strong">{{ doc.file_name }}</td>
          <td class="mono">{{ doc.document_type|replace({'_': ' '})|capitalize }}</td>
          <td class="mono">{{ doc.uploaded_at|date('d M Y') }}</td>
          <td>
            {% if doc.validation_status == 'valid' %}
              <span class="stamp mini approved">Valid</span>
            {% elseif doc.validation_status == 'rejected' %}
              <span class="stamp mini rejected">Rejected</span>
            {% else %}
              <span class="stamp mini pending">Pending</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice" style="margin-bottom:32px;">No documents uploaded yet.</div>
{% endif %}

<div class="section-title">Payments<div class="rule"></div></div>

{% if payments %}
  <table>
    <thead><tr><th>Type</th><th>Amount</th><th>Method</th><th>Date</th><th>Status</th></tr></thead>
    <tbody>
      {% for p in payments %}
        <tr>
          <td>{{ p.payment_type|replace({'_': ' '})|capitalize }}</td>
          <td class="mono">{{ p.currency }} {{ p.amount|number_format(0) }}</td>
          <td class="mono">{{ p.payment_method|replace({'_': ' '})|capitalize }}</td>
          <td class="mono">{{ p.payment_date|date('d M Y') }}</td>
          <td>
            {% if p.status == 'confirmed' %}
              <span class="stamp mini approved">Confirmed</span>
            {% elseif p.status == 'rejected' %}
              <span class="stamp mini rejected">Rejected</span>
            {% else %}
              <span class="stamp mini pending">Pending</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="notice">No payment records on file yet.</div>
{% endif %}

<!-- ============ MODAL: UPLOAD DOCUMENT ============ -->
<div class="modal-overlay" id="uploadModal" onclick="closeModal(event,'uploadModal')">
  <div class="modal" onclick="event.stopPropagation()">
    <button class="modal-close" onclick="hideModal('uploadModal')">✕ Close</button>
    <div class="ref">REQ-{{ student_number }} · NEW DOCUMENT</div>
    <h2>Upload a document</h2>
    <div class="sub">Accepted formats: PDF, JPG, PNG. Files are checked by the registrar before your record updates.</div>

    <form method="POST" action="/student/requirements/upload" enctype="multipart/form-data">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      <div class="field">
        <label>File</label>
        <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required>
      </div>

      <div class="field">
        <label>Document type</label>
        <select name="document_type" required>
          <option value="synopsis">Synopsis</option>
          <option value="proposal">Proposal</option>
          <option value="coursework_cert">Coursework certificate</option>
          <option value="payment_proof">Payment proof</option>
          <option value="thesis_draft">Thesis draft</option>
          <option value="final_thesis">Final thesis</option>
          <option value="publication">Publication</option>
        </select>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn ghost" onclick="hideModal('uploadModal')">Cancel</button>
        <button type="submit" class="btn brass">Submit for validation</button>
      </div>
    </form>
  </div>
</div>

{% endblock %}

{% block extra_scripts %}
<script>
  function openModal(id){ document.getElementById(id).classList.add('open'); }
  function hideModal(id){ document.getElementById(id).classList.remove('open'); }
  function closeModal(e, id){ if(e.target.id===id) hideModal(id); }
</script>
{% endblock %}