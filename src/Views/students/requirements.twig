{% extends 'layouts/student.twig' %}

{% block title %}Requirements{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Requirements</h1>
    <div class="sub">Documents scheduled for review under your thesis timeline.</div>
  </div>
  <div class="ref">{{ student_number }}</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

{% if no_thesis_schedule %}
  <div class="notice">No thesis schedule found for your registration.</div>
{% elseif not proposal_submitted %}
  <div class="notice">You need to submit your thesis proposal before requirement documents can be submitted. <a href="/student/proposal">Go to your proposal</a>.</div>
{% elseif not requirements %}
  <div class="notice">No documents are currently scheduled for review.</div>
{% else %}
  <table>
    <thead><tr><th>Document</th><th>Window</th><th>Status</th><th></th></tr></thead>
    <tbody>
      {% for item in requirements %}
        <tr>
          <td class="strong">{{ item.doc_type_name }}</td>
          <td class="mono">
            {% if item.document_submission_starts_at %}{{ item.document_submission_starts_at|date('d M Y') }}{% else %}—{% endif %}
            –
            {% if item.document_submission_deadline %}{{ item.document_submission_deadline|date('d M Y') }}{% else %}—{% endif %}
          </td>
          <td>
            {% if item.submission %}
              {% if item.submission.document_status == 'draft' %}
                <span class="stamp mini pending">Draft</span>
              {% elseif item.submission.validation_status == 'valid' %}
                <span class="stamp mini approved">Valid</span>
              {% elseif item.submission.validation_status == 'rejected' %}
                <span class="stamp mini rejected">Rejected — locked</span>
              {% else %}
                <span class="stamp mini pending">Submitted — pending review</span>
              {% endif %}
            {% elseif item.past_deadline %}
              <span class="stamp mini rejected">Deadline passed</span>
            {% elseif item.not_open_yet %}
              <span class="stamp mini pending">Not open yet</span>
            {% else %}
              <span class="stamp mini pending">Not submitted</span>
            {% endif %}
          </td>
                    <td style="white-space:nowrap;">
            {% if item.submission %}
              <a href="/{{ item.submission.file_path }}" target="_blank" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">Download</a>
            {% endif %}
            {% if item.window_open %}
              <button type="button" class="btn ghost" style="padding:6px 12px; font-size:.72rem;"
                onclick="openUploadModal('{{ item.exam_schedule_id }}', '{{ item.document_type_id }}', '{{ item.doc_type_name|escape('js') }}')">
                {{ item.submission ? 'Replace draft' : 'Upload' }}
              </button>
              {% if item.submission %}
                <form method="POST" action="/student/requirements/submit-draft" style="display:inline;">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <input type="hidden" name="document_id" value="{{ item.submission.document_id }}">
                  <button type="submit" class="btn brass" style="padding:6px 12px; font-size:.72rem;">Submit</button>
                </form>
              {% endif %}
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

<!-- ============ MODAL: SUBMIT DOCUMENT ============ -->
<div class="modal-overlay" id="uploadModal" onclick="closeUploadModal(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <button type="button" class="modal-close" onclick="hideUploadModal()">✕ Close</button>
    <div class="ref">{{ student_number }} · SUBMISSION</div>
    <h2 id="uploadModalTitle">Submit document</h2>
    <div class="sub">Accepted format: PDF, up to 10MB. Once submitted, this document cannot be changed.</div>

    <form method="POST" action="/student/requirements/upload" enctype="multipart/form-data">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="exam_schedule_id" id="uploadExamScheduleId">
      <input type="hidden" name="document_type_id" id="uploadDocumentTypeId">

      <div class="field">
        <label>File</label>
        <input type="file" name="document_file" accept="application/pdf" required>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn ghost" onclick="hideUploadModal()">Cancel</button>
        <button type="submit" name="action" value="draft" class="btn ghost">Save as draft</button>
        <button type="submit" name="action" value="submit" class="btn brass">Submit</button>
      </div>
    </form>
  </div>
</div>

{% endblock %}

{% block extra_scripts %}
<script>
  function openUploadModal(examScheduleId, documentTypeId, label){
    document.getElementById('uploadExamScheduleId').value = examScheduleId;
    document.getElementById('uploadDocumentTypeId').value = documentTypeId;
    document.getElementById('uploadModalTitle').textContent = 'Upload ' + label;
    document.getElementById('uploadModal').classList.add('open');
  }
  function hideUploadModal(){
    document.getElementById('uploadModal').classList.remove('open');
  }
  function closeUploadModal(e){
    if (e.target.id === 'uploadModal') hideUploadModal();
  }
</script>
{% endblock %}