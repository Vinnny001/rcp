{% extends 'layouts/student.twig' %}
{% import 'partials/_exam_macros.twig' as exam_macros %}

{% block title %}Examination & Graduation{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Examination &amp; graduation</h1>
    <div class="sub">Outcomes become visible here once grading and graduate school approval are complete.</div>
  </div>
  <div class="ref">EXM-{{ student_number }}</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

{% if exam_windows %}
  <div class="section-title">Ready to be examined?<div class="rule"></div></div>
  <div class="meta" style="margin-bottom:16px;">
    Tell your coordinator when you are ready and they will schedule the exam. Fees and documents have to be settled first.
  </div>

  <div class="grid cols-2" style="margin-bottom:32px;">
    {% for w in exam_windows %}
      <div class="card">
        <h3>{{ w.stage_name }}</h3>
        <div class="meta">
          {{ w.exam_type|capitalize }} · {{ w.starts_at|date('d M Y') }}
          {%- if w.ends_at %} to {{ w.ends_at|date('d M Y') }}{% endif %}
        </div>
        {% if w.exam_schedule_description %}
          <div class="meta" style="margin-top:4px;">{{ w.exam_schedule_description }}</div>
        {% endif %}

        {% if w.meeting_id %}
          <span class="stamp mini approved" style="margin-top:12px;">Exam scheduled</span>
          <div class="meta" style="margin-top:6px;">{{ w.meeting_at|date('d M Y, g:i A') }}</div>

        {% elseif w.marked_ready_at %}
          <span class="stamp mini pending" style="margin-top:12px;">Waiting on your coordinator</span>
          <div class="meta" style="margin-top:6px;">You marked yourself ready on {{ w.marked_ready_at|date('d M Y') }}.</div>
          <form method="POST" action="/student/exam/ready" style="margin-top:10px;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="exam_schedule_id" value="{{ w.exam_schedule_id }}">
            <input type="hidden" name="withdraw" value="1">
            <button type="submit" class="btn ghost" style="padding:6px 14px; font-size:.72rem;">I am not ready after all</button>
          </form>

        {% elseif w.blockers %}
          <div class="meta" style="margin-top:12px;">Outstanding before you can be examined</div>
          <ul style="font-size:.8rem; margin:6px 0 0 16px; padding:0; color: var(--rust);">
            {% for b in w.blockers %}<li>{{ b }}</li>{% endfor %}
          </ul>

        {% else %}
          <div class="meta" style="margin-top:12px;">Everything is settled — fees confirmed and documents in.</div>
          <form method="POST" action="/student/exam/ready" style="margin-top:10px;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="exam_schedule_id" value="{{ w.exam_schedule_id }}">
            <button type="submit" class="btn brass">I am ready to be examined</button>
          </form>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}

{% set proposal_approved = proposal and proposal.status == 'approved' %}

<div class="grid cols-2" style="margin-bottom:32px;">
  {{ exam_macros.exam_card('Internal examination', internal_exam, proposal_approved) }}
  {{ exam_macros.exam_card('External examination', external_exam, proposal_approved) }}
</div>

<div class="section-title">Graduation<div class="rule"></div></div>

{% if graduation %}
  <div class="card">
    <h3>Ceremony {{ graduation.ceremony_year }}</h3>
    <div class="meta">
      {% if graduation.award %}{{ graduation.award }}{% endif %}
      {% if graduation.class_of_award %} · {{ graduation.class_of_award }}{% endif %}
    </div>
    {% if graduation.graduate_school_approved %}
      <span class="stamp mini approved">Approved{% if graduation.approval_date %} — {{ graduation.approval_date|date('d M Y') }}{% endif %}</span>
    {% else %}
      <span class="stamp mini pending">Pending graduate school approval</span>
    {% endif %}
  </div>
{% else %}
  <div class="card">
    <h3>Not yet on the graduation list</h3>
    <div class="meta">You'll be added here automatically once your examination outcome is recorded and outstanding documents are cleared.</div>
    <span class="stamp mini pending">Not yet eligible</span>
  </div>
{% endif %}

{% endblock %}