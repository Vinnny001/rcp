{% extends 'layouts/student.twig' %}

{% block title %}Supervisors{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>Supervisors</h1>
    <div class="sub">Choose up to {{ max_choices }} supervisors in order of preference. Your department reviews the whole list before anyone is approached.</div>
  </div>
  <div class="ref">SUP-{{ student_number }}</div>
</div>

{% if success %}
  <div class="notice" style="border-left-color: var(--forest); background:#eef3ee; color: var(--forest);">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="notice" style="border-left-color: var(--rust); background:#f6eae7; color: var(--rust);">{{ error }}</div>
{% endif %}

{% if not proposal_submitted %}
  <div class="notice">
    {% if proposal %}
      Your proposal is still a draft. A shortlist goes to the department
      attached to a proposal they can read, so
      <a href="/student/proposal">submit your proposal</a> first — you can
      come straight back here afterwards.
    {% else %}
      <a href="/student/proposal">Write your thesis proposal</a> first — a
      shortlist is attached to it.
    {% endif %}
  </div>
{% else %}

  {# ---------- tracker: only once something has been submitted ---------- #}
  {% if shortlist %}
    <div class="section-title">Your shortlist<div class="rule"></div></div>

    {% set state = {
      'pending_coordinator': ['With your research coordinator', 'They will take it to the department for review.'],
      'meeting_scheduled':   ['Under department review', 'A meeting has been arranged. Nothing is decided until the minutes are finalised.'],
      'approved':            ['Approved by the department', 'Supervisors are being approached one at a time, starting with your preferred main.'],
      'rejected':            ['Not approved', 'The department did not approve this shortlist. You can submit a new one below.'],
      'exhausted':           ['Nobody was available', 'Every supervisor on your list declined. You can submit a new one below.'],
    }[shortlist.status] | default(['Submitted', '']) %}

    <div class="card" style="margin-bottom:18px;">
      <h3>{{ state[0] }}</h3>
      {% if state[1] %}<div class="meta">{{ state[1] }}</div>{% endif %}
      <div class="meta" style="margin-top:6px;">Submitted {{ shortlist.created_at|date('d M Y') }}</div>

      {% if shortlist.rejection_reason %}
        <div class="notice" style="margin-top:12px; border-left-color: var(--rust); background:#f6eae7;">
          <span class="strong">From the meeting minutes:</span><br>{{ shortlist.rejection_reason }}
        </div>
      {% endif %}
    </div>

    <table style="margin-bottom:28px;">
      <thead>
        <tr><th>#</th><th>Supervisor</th><th>Role you asked for</th><th>Status</th></tr>
      </thead>
      <tbody>
        {% for c in choices %}
          <tr>
            <td class="mono">{{ c.rank_position }}</td>
            <td class="strong">{{ c.lecturer_name }}</td>
            <td>{{ c.is_preferred_main ? 'Preferred main supervisor' : 'Co-supervisor' }}</td>
            <td>
              {% if c.request_status == 'not_sent' %}
                <span class="meta">Not yet approached</span>
              {% elseif c.request_status == 'pending' %}
                <span class="stamp mini pending">Awaiting their reply</span>
              {% elseif c.request_status == 'accepted' %}
                <span class="stamp mini approved">Accepted</span>
              {% elseif c.request_status == 'declined' %}
                <span class="stamp mini rejected">Declined</span>
                {% if c.decline_reason %}<div class="meta" style="font-size:.72rem;">{{ c.decline_reason }}</div>{% endif %}
              {% else %}
                <span class="meta">Withdrawn — your panel was already full</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}

  {# ---------- builder: only when there is nothing live ---------- #}
  {% if can_resubmit %}
    <div class="section-title">{{ shortlist ? 'Submit a new shortlist' : 'Build your shortlist' }}<div class="rule"></div></div>
    <div class="meta" style="margin-bottom:10px;">
      Choose up to {{ max_choices }} supervisors and say what order you would
      like them asked in. The department votes on the whole list at once;
      after that they are approached <span class="strong">one at a time, in your
      order</span> — the next is only asked if the one before says no. You end up
      with at most {{ max_supervisors }} supervisors, one of them your main
      supervisor.
    </div>
    <div class="meta" style="margin-bottom:16px;">
      Naming a preferred main supervisor is optional. Name one and they are
      asked before anyone else; name none and the order below decides, with
      whoever accepts first becoming your main supervisor.
    </div>

    {% if supervisors %}
      <form method="POST" action="/student/supervisors">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        {# Radios cannot be cleared once set, so the group carries its own
           "none" option — otherwise changing your mind means reloading. #}
        <label class="card" style="display:flex; gap:8px; align-items:center; margin-bottom:16px; padding:10px 14px; font-size:.78rem;">
          <input type="radio" name="preferred_main" value=""
                 {{ old.preferred_main|default('') == '' ? 'checked' : '' }}>
          No preferred main — ask them in the order I set below
        </label>

        <div class="grid cols-2" style="margin-bottom:20px;">
          {% for s in supervisors %}
            <div class="card">
              <h3>{{ s.name }}</h3>
              <div class="meta">{{ s.department_name }}{% if s.specialization %} · {{ s.specialization }}{% endif %}</div>

              {% if s.research_interests %}
                <p style="font-size:.85rem; line-height:1.6; margin-top:10px;">{{ s.research_interests }}</p>
              {% endif %}

              {% if s.links %}
                <div class="meta" style="margin-top:8px;">
                  {% for link in s.links %}
                    <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label ?: link.platform|replace({'_': ' '})|capitalize }}</a>{% if not loop.last %} · {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if s.theses %}
                <div class="meta" style="margin-top:10px;">Previously supervised</div>
                <ul style="font-size:.8rem; margin:4px 0 0 16px; padding:0;">
                  {% for t in s.theses|slice(0, 3) %}
                    <li>{{ t.title }}</li>
                  {% endfor %}
                </ul>
                {% if s.theses|length > 3 %}
                  <div class="meta" style="font-size:.72rem;">and {{ s.theses|length - 3 }} more</div>
                {% endif %}
              {% else %}
                <div class="meta" style="margin-top:10px;">No completed supervisions on record yet</div>
              {% endif %}

              <div class="meta" style="margin-top:10px;">
                Current load {{ s.current_load }} of {{ s.max_load }}
                {% if not s.has_capacity %}
                  <span style="color: var(--rust);">· at capacity</span>
                {% endif %}
              </div>

              {% set my_rank = old.rank[s.lecturer_id]|default('') %}
              <div style="display:flex; gap:14px; align-items:center; margin-top:12px; flex-wrap:wrap;">
                <label style="font-size:.78rem; display:flex; gap:6px; align-items:center;">
                  Ask them
                  <select name="rank[{{ s.lecturer_id }}]" style="max-width:110px;">
                    <option value="">not at all</option>
                    {% for i in 1..max_choices %}
                      <option value="{{ i }}" {{ my_rank == i ? 'selected' : '' }}>{{ i }}{{ i == 1 ? 'st' : (i == 2 ? 'nd' : (i == 3 ? 'rd' : 'th')) }}</option>
                    {% endfor %}
                  </select>
                </label>
                <label style="font-size:.78rem; display:flex; gap:6px; align-items:center;">
                  <input type="radio" name="preferred_main" value="{{ s.lecturer_id }}"
                         {{ old.preferred_main|default('') == s.lecturer_id ? 'checked' : '' }}>
                  Preferred main
                </label>
              </div>
            </div>
          {% endfor %}
        </div>

        <button type="submit" class="btn brass">Submit shortlist</button>
      </form>
    {% else %}
      <div class="notice">No supervisors are listed for your department yet. Your coordinator can help.</div>
    {% endif %}
  {% endif %}

{% endif %}

{% endblock %}
