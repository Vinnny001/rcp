{% extends 'layouts/student.twig' %}

{% block title %}My Documents{% endblock %}

{% block content %}

<div class="page-head">
  <div>
    <h1>My documents</h1>
    <div class="sub">Every document you've submitted, with its current status and submission date.</div>
  </div>
  <div class="ref">{{ student_number }}</div>
</div>

{% if not documents %}
  <div class="notice">You haven't submitted any documents yet.</div>
{% else %}
  <div class="notice" style="margin-bottom:18px;">
    The status below is your supervisor's validation check. Once a document has been reviewed and scored in a meeting, its outcome appears on <a href="/student/outcomes">My results</a>.
  </div>
{% endif %}

{% if documents %}
  <table>
    <thead><tr><th>Document</th><th>Type</th><th>Submitted</th><th>Status</th><th>Review</th><th></th></tr></thead>
    <tbody>
      {% for doc in documents %}
        <tr>
          <td class="strong">{{ doc.file_name }}</td>
          <td class="mono">{{ doc.doc_type_name }}</td>
          <td class="mono">{{ doc.submitted_at ? doc.submitted_at|date('d M Y') : doc.uploaded_at|date('d M Y') }}</td>
          <td>
            {% if doc.document_status == 'draft' %}
              <span class="stamp mini pending">Draft</span>
            {% elseif doc.document_status == 'submitted' %}
              <span class="stamp mini review">Submitted</span>
            {% elseif doc.document_status == 'under_review' %}
              <span class="stamp mini review">Under review</span>
            {% elseif doc.document_status == 'approved' or doc.document_status == 'final' %}
              <span class="stamp mini approved">{{ doc.document_status|capitalize }}</span>
            {% elseif doc.document_status == 'rejected' %}
              <span class="stamp mini rejected">Rejected</span>
            {% elseif doc.document_status == 'resubmitted' %}
              <span class="stamp mini pending">Resubmitted</span>
            {% else %}
              <span class="stamp mini pending">{{ doc.document_status|capitalize }}</span>
            {% endif %}
          </td>
          <td>
            {% if doc.validation_status == 'valid' %}
              <span class="stamp mini approved">Valid</span>
            {% elseif doc.validation_status == 'rejected' %}
              <span class="stamp mini rejected">Rejected</span>
            {% else %}
              <span class="stamp mini pending">Pending</span>
            {% endif %}
          </td>
          <td>
            <a href="/{{ doc.file_path }}" target="_blank" class="btn ghost" style="padding:6px 12px; font-size:.72rem;">Download</a>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

{% endblock %}